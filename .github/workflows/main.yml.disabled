name: 🚀 CloudBridge Relay - Main CI/CD Pipeline

on:
  push:
    branches: [ main, develop ]
    tags: [ 'v*' ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy to'
        required: true
        default: 'staging'
        type: choice
        options:
        - staging
        - production
        - skip-deploy
      skip-tests:
        description: 'Skip tests (for emergency deployments)'
        required: false
        default: false
        type: boolean

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  GO_VERSION: '1.25'
  DOCKER_BUILDKIT: 1

jobs:
  # ========================================
  # TESTING & QUALITY ASSURANCE
  # ========================================
  test:
    name: 🧪 Test & Quality
    runs-on: ubuntu-latest
    if: ${{ !inputs.skip-tests }}
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name:  Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}
          cache: true

      - name: 📦 Download dependencies
        run: |
          go mod download
          go mod verify

      - name: 🧪 Run unit tests
        run: |
          go test -v -race -coverprofile=coverage.txt -covermode=atomic ./...
          go test -v -race -coverprofile=coverage.txt -covermode=atomic ./cmd/...

      - name: 📊 Upload coverage to Codecov
        uses: codecov/codecov-action@v4
        with:
          file: ./coverage.txt
          fail_ci_if_error: true
          verbose: true

      - name: 🔍 Run golangci-lint
        uses: golangci/golangci-lint-action@v4
        with:
          version: latest
          args: --timeout=5m

      - name: 🔒 Run security scan
        uses: securego/gosec@master
        with:
          args: ./...

      - name:  Run benchmarks
        run: |
          go test -bench=. -benchmem ./internal/... > benchmark-results.txt
          cat benchmark-results.txt

      - name: 📤 Upload test artifacts
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: |
            coverage.txt
            benchmark-results.txt
          retention-days: 30

  # ========================================
  # SECURITY AUDIT
  # ========================================
  security:
    name: 🔒 Security Audit
    runs-on: ubuntu-latest
    if: ${{ !inputs.skip-tests }}
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name:  Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}
          cache: true

      - name: 🐍 Install Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: 🛠️ Install security tools
        run: |
          # Install gosec
          go install github.com/securecodewarrior/gosec/v2/cmd/gosec@latest
          
          # Install safety for Python dependencies
          pip install safety==3.5.2
          
          # Install additional security tools
          sudo apt-get update && sudo apt-get install -y jq lynis
          
          # Install nancy for Go dependencies
          go install github.com/sonatype-nexus-community/nancy@latest

      - name: 🔍 Run comprehensive security scan
        run: |
          # Create security reports directory
          mkdir -p security_reports
          
          # Run gosec for Go security
          echo "Running gosec security scan..."
          gosec -fmt json -out security_reports/gosec-results.json ./... || {
            echo " gosec found issues, but continuing..."
          }
          
          # Run nancy for dependency vulnerabilities
          echo "Running nancy dependency scan..."
          go list -json -deps ./... | nancy sleuth --output json > security_reports/nancy-results.json || {
            echo " nancy found issues, but continuing..."
          }
          
          # Check for secrets
          echo "Running trufflehog secret scan..."
          # Note: This would require trufflehog to be installed
          
          echo "Security scan completed"

      - name: 📤 Upload security artifacts
        uses: actions/upload-artifact@v4
        with:
          name: security-reports
          path: |
            security_reports/
          retention-days: 30

  # ========================================
  # BUILD & PACKAGE
  # ========================================
  build:
    name: 🔨 Build & Package
    needs: [test, security]
    runs-on: ubuntu-latest
    if: always() && (needs.test.result == 'success' || needs.test.result == 'skipped') && (needs.security.result == 'success' || needs.security.result == 'skipped')
    
    outputs:
      version: ${{ steps.version.outputs.version }}
      build-time: ${{ steps.version.outputs.build-time }}
      git-commit: ${{ steps.version.outputs.git-commit }}
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name:  Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}
          cache: true

      - name: Set version info
        id: version
        run: |
          if [[ "$GITHUB_REF" == refs/tags/* ]]; then
            VERSION=${GITHUB_REF#refs/tags/}
          else
            VERSION=${GITHUB_SHA::8}
          fi
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "build-time=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> $GITHUB_OUTPUT
          echo "git-commit=$GITHUB_SHA" >> $GITHUB_OUTPUT

      - name: 🔨 Build binaries
        run: |
          chmod +x build.sh
          ./build.sh

      - name: 📦 Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: build-artifacts
          path: |
            build/
            bin/
          retention-days: 30

  # ========================================
  # DOCKER BUILD & PUSH
  # ========================================
  docker:
    name: 🐳 Docker Build & Push
    needs: build
    runs-on: ubuntu-latest
    if: github.event_name != 'pull_request'
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🐳 Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: 🔐 Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest,enable={{is_default_branch}}
            type=raw,value=${{ needs.build.outputs.version }}

      - name: 🏗️ Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: ./Dockerfile.production
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            VERSION=${{ needs.build.outputs.version }}
            BUILD_TIME=${{ needs.build.outputs.build-time }}
            GIT_COMMIT=${{ needs.build.outputs.git-commit }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ========================================
  # DEPLOYMENT
  # ========================================
  deploy-staging:
    name: 🚀 Deploy to Staging
    needs: [docker]
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/develop' || (github.event_name == 'workflow_dispatch' && inputs.environment == 'staging')
    environment: staging
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🚀 Deploy to staging
        run: |
          echo "🚀 Deploying to staging environment..."
          echo "Image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ needs.build.outputs.version }}"
          # Add your staging deployment logic here
          # Example: kubectl apply -f k8s/staging/

  deploy-production:
    name: 🚀 Deploy to Production
    needs: [docker]
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && inputs.environment == 'production')
    environment: production
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🚀 Deploy to production
        run: |
          echo "🚀 Deploying to production environment..."
          echo "Image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ needs.build.outputs.version }}"
          # Add your production deployment logic here
          # Example: kubectl apply -f k8s/production/

  # ========================================
  # RELEASE MANAGEMENT
  # ========================================
  release:
    name: 📦 Create Release
    needs: [docker]
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/v')
    permissions:
      contents: write
      packages: write
    
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name:  Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}

      - name: 🏗️ Build binaries for multiple platforms
        run: |
          mkdir -p dist
          
          # Linux amd64
          GOOS=linux GOARCH=amd64 go build -ldflags "-X main.version=${{ github.ref_name }}" -o dist/cloudbridge-relay-linux-amd64 ./cmd/relay
          
          # Linux arm64
          GOOS=linux GOARCH=arm64 go build -ldflags "-X main.version=${{ github.ref_name }}" -o dist/cloudbridge-relay-linux-arm64 ./cmd/relay
          
          # Windows amd64
          GOOS=windows GOARCH=amd64 go build -ldflags "-X main.version=${{ github.ref_name }}" -o dist/cloudbridge-relay-windows-amd64.exe ./cmd/relay
          
          # macOS amd64
          GOOS=darwin GOARCH=amd64 go build -ldflags "-X main.version=${{ github.ref_name }}" -o dist/cloudbridge-relay-darwin-amd64 ./cmd/relay
          
          # macOS arm64 (Apple Silicon)
          GOOS=darwin GOARCH=arm64 go build -ldflags "-X main.version=${{ github.ref_name }}" -o dist/cloudbridge-relay-darwin-arm64 ./cmd/relay

      - name: 📦 Create release archives
        run: |
          cd dist
          
          # Linux amd64
          tar -czf cloudbridge-relay-linux-amd64.tar.gz cloudbridge-relay-linux-amd64
          
          # Linux arm64
          tar -czf cloudbridge-relay-linux-arm64.tar.gz cloudbridge-relay-linux-arm64
          
          # Windows amd64
          zip cloudbridge-relay-windows-amd64.zip cloudbridge-relay-windows-amd64.exe
          
          # macOS amd64
          tar -czf cloudbridge-relay-darwin-amd64.tar.gz cloudbridge-relay-darwin-amd64
          
          # macOS arm64
          tar -czf cloudbridge-relay-darwin-arm64.tar.gz cloudbridge-relay-darwin-arm64

      - name: 📝 Generate changelog
        id: changelog
        run: |
          echo "## Changelog" > CHANGELOG.md
          echo "" >> CHANGELOG.md
          git log --pretty=format:"- %s (%h)" $(git describe --tags --abbrev=0 HEAD~1 2>/dev/null || echo "HEAD~10")..HEAD >> CHANGELOG.md
          echo "" >> CHANGELOG.md
          echo "**Full Changelog**: https://github.com/${{ github.repository }}/compare/$(git describe --tags --abbrev=0 HEAD~1 2>/dev/null || echo "HEAD~10")...${GITHUB_REF_NAME}" >> CHANGELOG.md

      - name: 🏷️ Create GitHub Release
        uses: softprops/action-gh-release@v1
        with:
          tag_name: ${{ github.ref_name }}
          name: CloudBridge Relay ${{ github.ref_name }}
          body_path: CHANGELOG.md
          draft: false
          prerelease: false
          files: |
            dist/*.tar.gz
            dist/*.zip
          token: ${{ secrets.GITHUB_TOKEN }}

  # ========================================
  # NOTIFICATIONS
  # ========================================
  notify:
    name: 📢 Notifications
    needs: [test, security, build, docker, deploy-staging, deploy-production, release]
    runs-on: ubuntu-latest
    if: always()
    
    steps:
      - name: 📢 Success notification
        if: needs.test.result == 'success' && needs.build.result == 'success' && needs.docker.result == 'success'
        run: |
          echo "CloudBridge Relay CI/CD Pipeline completed successfully!"
          echo "Version: ${{ needs.build.outputs.version }}"
          echo "Image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ needs.build.outputs.version }}"

      - name: 📢 Failure notification
        if: needs.test.result == 'failure' || needs.build.result == 'failure' || needs.docker.result == 'failure'
        run: |
          echo "❌ CloudBridge Relay CI/CD Pipeline failed!"
          echo "Test: ${{ needs.test.result }}"
          echo "Build: ${{ needs.build.result }}"
          echo "Docker: ${{ needs.docker.result }}"
          exit 1

      - name: 📢 Skipped notification
        if: needs.test.result == 'skipped'
        run: |
          echo "⏭️ Tests were skipped for this run"
          echo "Build: ${{ needs.build.result }}"
          echo "Docker: ${{ needs.docker.result }}"
