name: Test Coverage & Quality

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]
  schedule:
    # Run every day at 6:00 UTC
    - cron: '0 6 * * *'
  workflow_dispatch:

env:
  GO_VERSION: '1.25.12'
  COVERAGE_THRESHOLD: 80

jobs:
  test-coverage:
    name: Test Coverage Analysis
    runs-on: ubuntu-latest
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0

    - name:  Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: true

    - name: Install dependencies
      run: |
        go mod download
        go mod verify

    - name: Run unit tests
      run: |
        echo "🧪 Running unit tests..."
        go test -v -race -short ./internal/... ./config/...

    - name:  Run integration tests
      run: |
        echo " Running integration tests..."
        go test -v -race -tags=integration ./...

    - name: Run benchmarks
      run: |
        echo "Running benchmarks..."
        go test -v -bench=. -benchmem ./...

    - name: Generate coverage report
      run: |
        echo "Generating coverage report..."
        mkdir -p coverage_reports
        go test -v -race -coverprofile=coverage_reports/coverage.out -covermode=atomic ./...
        go tool cover -html=coverage_reports/coverage.out -o coverage_reports/coverage.html
        go tool cover -func=coverage_reports/coverage.out > coverage_reports/coverage.txt

    - name:  Check coverage threshold
      run: |
        echo " Checking coverage threshold..."
        COVERAGE=$(go tool cover -func=coverage_reports/coverage.out | tail -1 | awk '{print $3}' | sed 's/%//')
        echo "Current coverage: ${COVERAGE}%"
        echo "Required coverage: ${COVERAGE_THRESHOLD}%"
        
        if (( $(echo "$COVERAGE < $COVERAGE_THRESHOLD" | bc -l) )); then
          echo "Coverage $COVERAGE% is below threshold $COVERAGE_THRESHOLD%"
          exit 1
        else
          echo "Coverage $COVERAGE% meets threshold $COVERAGE_THRESHOLD%"
        fi

    - name: Upload coverage reports
      uses: actions/upload-artifact@v4
      with:
        name: coverage-reports
        path: coverage_reports/
        retention-days: 30

    - name: Upload to Codecov
      uses: codecov/codecov-action@v4
      with:
        file: coverage_reports/coverage.out
        flags: unittests
        name: codecov-umbrella
        fail_ci_if_error: false

  test-critical-components:
    name: 🔥 Critical Components Tests
    runs-on: ubuntu-latest
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4

    - name:  Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: true

    - name: 🔥 Test critical components
      run: |
        echo "🔥 Testing critical components..."
        go test -v -race -cover ./internal/token/... ./internal/auth/... ./internal/p2p/... ./internal/api/... ./internal/quic/... ./internal/keycloak/... ./config/...

  test-performance:
    name: Performance Tests
    runs-on: ubuntu-latest
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4

    - name:  Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: true

    - name: Run performance tests
      run: |
        echo "Running performance tests..."
        go test -v -bench=. -benchmem -benchtime=10s ./...

    - name: Generate performance report
      run: |
        echo "Generating performance report..."
        go test -bench=. -benchmem -benchtime=30s ./... > performance_report.txt
        cat performance_report.txt

  test-race-detection:
    name: 🏃 Race Detection Tests
    runs-on: ubuntu-latest
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4

    - name:  Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: true

    - name: 🏃 Run race detection tests
      run: |
        echo "🏃 Running race detection tests..."
        go test -v -race ./...

  test-coverage-by-component:
    name: Coverage by Component
    runs-on: ubuntu-latest
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4

    - name:  Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: true

    - name: Generate component coverage
      run: |
        echo "Generating coverage by component..."
        
        # Critical components
        echo "🔥 Critical Components:"
        go test -cover ./internal/token/... | grep coverage
        go test -cover ./internal/auth/... | grep coverage
        go test -cover ./internal/p2p/... | grep coverage
        go test -cover ./internal/api/... | grep coverage
        go test -cover ./internal/quic/... | grep coverage
        go test -cover ./internal/keycloak/... | grep coverage
        go test -cover ./config/... | grep coverage
        
        # Medium priority components
        echo " Medium Priority Components:"
        go test -cover ./internal/ai/... | grep coverage
        go test -cover ./internal/cadence/... | grep coverage
        go test -cover ./internal/wireguard/... | grep coverage
        go test -cover ./internal/tenant/... | grep coverage
        
        # Low priority components
        echo "Low Priority Components:"
        go test -cover ./internal/logger/... | grep coverage
        go test -cover ./internal/errors/... | grep coverage
        go test -cover ./internal/metrics/... | grep coverage
        go test -cover ./internal/health/... | grep coverage

  coverage-summary:
    name: Coverage Summary
    runs-on: ubuntu-latest
    needs: [test-coverage, test-critical-components, test-coverage-by-component]
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4

    - name:  Set up Go
      uses: actions/setup-go@v5
      with:
        go-version: ${{ env.GO_VERSION }}
        cache: true

    - name: Generate final coverage summary
      run: |
        echo "Final Coverage Summary"
        echo "========================"
        
        # Generate overall coverage
        go test -coverprofile=coverage.out -covermode=atomic ./...
        COVERAGE=$(go tool cover -func=coverage.out | tail -1 | awk '{print $3}')
        echo "Overall Coverage: $COVERAGE"
        
        # Component breakdown
        echo ""
        echo "Component Coverage:"
        echo "=================="
        
        for component in internal/token internal/auth internal/p2p internal/api internal/quic internal/keycloak config; do
          if [ -d "$component" ]; then
            COVERAGE=$(go test -cover ./$component/... 2>/dev/null | grep coverage | awk '{print $5}' || echo "0.0%")
            echo "$component: $COVERAGE"
          fi
        done
        
        # Check if coverage meets threshold
        COVERAGE_NUM=$(echo $COVERAGE | sed 's/%//')
        if (( $(echo "$COVERAGE_NUM < $COVERAGE_THRESHOLD" | bc -l) )); then
          echo ""
          echo "Coverage $COVERAGE is below threshold $COVERAGE_THRESHOLD%"
          echo "Please add more tests to improve coverage."
          exit 1
        else
          echo ""
          echo "Coverage $COVERAGE meets threshold $COVERAGE_THRESHOLD%"
        fi

    - name: Comment on PR
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          const coverage = process.env.COVERAGE || '0.0%';
          
          const comment = `## Test Coverage Report
          
          **Overall Coverage:** ${coverage}
          **Threshold:** ${process.env.COVERAGE_THRESHOLD}%
          
          ${coverage >= process.env.COVERAGE_THRESHOLD ? '' : ''} Coverage ${coverage >= process.env.COVERAGE_THRESHOLD ? 'meets' : 'does not meet'} the required threshold.
          
          ### Component Coverage:
          - 🔥 Critical Components: See detailed report above
          - Medium Priority: See detailed report above  
          - Low Priority: See detailed report above
          
          [View detailed coverage report](https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }})
          `;
          
          github.rest.issues.createComment({
            issue_number: context.issue.number,
            owner: context.repo.owner,
            repo: context.repo.repo,
            body: comment
          });
