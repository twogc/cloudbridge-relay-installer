# CloudBridge Relay Installer - npm security configuration
# October 2025 - Enhanced security measures

# Security settings
audit-level=moderate
fund=false
save-exact=true
package-lock=true

# Ignore scripts for security (where possible)
ignore-scripts=false

# Use npm ci for production builds
prefer-offline=true

# Security audit settings
audit=true
audit-level=moderate

# Lock file settings
package-lock=true
shrinkwrap=true

# Registry settings (use official npm registry)
registry=https://registry.npmjs.org/

# Security headers
strict-ssl=true
