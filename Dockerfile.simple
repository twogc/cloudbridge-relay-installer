# Simple Dockerfile for CloudBridge Relay
FROM alpine:3.18

# Install runtime dependencies
RUN apk update && apk --no-cache add ca-certificates tzdata

# Create user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Copy binary
COPY bin/cloudbridge-relay .

# Copy configs
COPY configs ./configs

# Create directories
RUN mkdir -p /app/data /app/certs && \
    chown -R appuser:appgroup /app/data /app/certs

# Set permissions
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose ports
EXPOSE 9091 8082 8443 5553/udp 19302/udp 9090/udp 9092/udp

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:9091/health || exit 1

# Run the application
CMD ["./cloudbridge-relay"]
