[ req ]
default_bits       = 2048
distinguished_name = req_distinguished_name
req_extensions     = req_ext
x509_extensions    = v3_ca
prompt             = no

[ req_distinguished_name ]
C  = RU
ST = Moscow
L  = Moscow
O  = 2GC Technologies
OU = CloudBridge Relay
CN = cloudbridge-relay

[ req_ext ]
subjectAltName = @alt_names
keyUsage = keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth, clientAuth

[ v3_ca ]
subjectAltName = @alt_names
basicConstraints = CA:FALSE
keyUsage = keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth, clientAuth

[ alt_names ]
# CloudBridge Relay service names
DNS.1 = cloudbridge-relay
DNS.2 = cloudbridge-relay.cloudbridge.svc.cluster.local
DNS.3 = cloudbridge-relay.cloudbridge.svc.cluster.local
DNS.4 = localhost
DNS.5 = *.cloudbridge.svc.cluster.local

# IP addresses
IP.1  = 127.0.0.1
IP.2  = 10.96.83.60
IP.3  = 10.244.0.144
IP.4  = 10.244.0.145
IP.5  = 10.244.0.146
