<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
  <version>6.0</version>
  <date>2025-09-27T00:00:00Z</date>

  <groups>
    <group>
      <uuid>a7808b624fa3454d8de41ef5e47b4c6e</uuid>
      <name>CloudBridge</name>
    </group>
  </groups>

  <templates>
    <template>
      <uuid>10f3cd1b047c44f69d77d638b6b13cb4</uuid>
      <template>CloudBridge Relay Modular Template</template>
      <name>CloudBridge Relay Modular Template</name>
      <description>Template for monitoring CloudBridge Relay Server with P2P/QUIC/MASQUE connectivity metrics</description>
      <groups>
        <group>
          <name>CloudBridge</name>
        </group>
      </groups>

      <macros>
        <macro><macro>{$CB.RELAY.MIN_CONN}</macro><value>1</value></macro>
        <macro><macro>{$CB.P2P.CONNECTIONS.MIN}</macro><value>1</value></macro>
        <macro><macro>{$CB.P2P.LATENCY.WARN}</macro><value>1000</value></macro>
        <macro><macro>{$CB.P2P.LATENCY.HIGH}</macro><value>2000</value></macro>
        <macro><macro>{$CB.P2P.THROUGHPUT.MIN}</macro><value>1000</value></macro>
        <macro><macro>{$CB.P2P.PACKET_LOSS.WARN}</macro><value>5</value></macro>
        <macro><macro>{$CB.P2P.PACKET_LOSS.HIGH}</macro><value>10</value></macro>
        <macro><macro>{$CB.P2P.DDOS.THRESHOLD}</macro><value>50</value></macro>
        <macro><macro>{$CB.MASQUE.TUNNELS.MIN}</macro><value>1</value></macro>
        <macro><macro>{$CB.NODATA.WINDOW}</macro><value>2m</value></macro>
      </macros>

      <items>
        <!-- ===================== Relay Server Items ===================== -->
        <item>
          <uuid>4e01c50c6a604a4a90e7631a5685b8bb</uuid>
          <name>Relay Active Connections</name>
          <type>ZABBIX_PASSIVE</type>
          <key>cloudbridge.relay.json.active_connections</key>
          <delay>30s</delay>
          <history>7d</history>
          <trends>365d</trends>
          <value_type>UNSIGNED</value_type>
          <units>connections</units>
          <status>ENABLED</status>
          <tags>
            <tag><tag>component</tag><value>relay</value></tag>
            <tag><tag>scope</tag><value>capacity</value></tag>
          </tags>
        </item>

        <item>
          <uuid>8eb1c00ced3f4af2a9d85fc2a2d9abdd</uuid>
          <name>Relay Uptime</name>
          <type>ZABBIX_PASSIVE</type>
          <key>cloudbridge.relay.json.uptime_seconds</key>
          <delay>30s</delay>
          <history>7d</history>
          <trends>365d</trends>
          <value_type>UNSIGNED</value_type>
          <units>seconds</units>
          <status>ENABLED</status>
          <tags>
            <tag><tag>component</tag><value>relay</value></tag>
            <tag><tag>scope</tag><value>availability</value></tag>
          </tags>
        </item>

        <item>
          <uuid>15fa808fb9df49b5af1596f153cbebef</uuid>
          <name>Relay Memory Usage (MB)</name>
