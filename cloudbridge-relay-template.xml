          <delay>30s</delay>
          <history>7d</history>
          <trends>365d</trends>
          <value_type>FLOAT</value_type>
          <units>MB</units>
          <status>ENABLED</status>
          <tags>
            <tag><tag>component</tag><value>relay</value></tag>
            <tag><tag>scope</tag><value>performance</value></tag>
          </tags>
        </item>

        <item>
          <uuid>c4409f8a0fd2450a92afe063b78f754f</uuid>
          <name>Relay Goroutines</name>
          <type>ZABBIX_PASSIVE</type>
          <key>cloudbridge.relay.json.goroutines</key>
