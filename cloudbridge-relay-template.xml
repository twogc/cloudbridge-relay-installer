      </items>
    </template>
  </templates>

  <triggers>
    <!-- ======================== Relay Triggers ======================== -->
    <trigger>
      <uuid>0ad96b74ba6a4dad840796435442cd33</uuid>
      <expression>min(/CloudBridge Relay Modular Template/cloudbridge.relay.json.active_connections,5m)&lt;{$CB.RELAY.MIN_CONN}</expression>
      <name>CloudBridge Relay: no active connections</name>
      <priority>HIGH</priority>
      <description>CloudBridge Relay has no active connections for 5 minutes</description>
      <status>ENABLED</status>
      <manual_close>NO</manual_close>
      <tags>
        <tag><tag>scope</tag><value>availability</value></tag>
        <tag><tag>component</tag><value>relay</value></tag>
      </tags>
    </trigger>

    <!-- ======================== P2P QUIC Triggers ======================== -->
    <trigger>
      <uuid>d6b81c1c83e24b819d252f36e15063fb</uuid>
      <expression>min(/CloudBridge Relay Modular Template/p2p.quic.connections.active,5m)&lt;{$CB.P2P.CONNECTIONS.MIN}</expression>
      <name>P2P QUIC: No Active Connections</name>
      <priority>HIGH</priority>
      <description>P2P QUIC has no active connections for 5 minutes</description>
      <status>ENABLED</status>
      <manual_close>NO</manual_close>
      <tags>
        <tag><tag>scope</tag><value>connectivity</value></tag>
        <tag><tag>component</tag><value>p2p</value></tag>
      </tags>
    </trigger>

    <!-- ====================== MASQUE Triggers ====================== -->
    <trigger>
      <uuid>e2eb683107614477b1db1781f7e354eb</uuid>
      <expression>last(/CloudBridge Relay Modular Template/masque.tunnels.active)&lt;{$CB.MASQUE.TUNNELS.MIN}</expression>
      <name>MASQUE: No Active Tunnels</name>
      <priority>WARNING</priority>
      <description>MASQUE has no active tunnels</description>
      <status>ENABLED</status>
      <manual_close>NO</manual_close>
      <tags>
        <tag><tag>scope</tag><value>connectivity</value></tag>
        <tag><tag>component</tag><value>masque</value></tag>
      </tags>
    </trigger>
  </triggers>
</zabbix_export>
