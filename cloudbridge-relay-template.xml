        <item>
          <uuid>ea0589bc86de46719b297fb9770ecb9b</uuid>
          <name>MASQUE Connect IP Requests</name>
          <type>ZABBIX_PASSIVE</type>
          <key>masque.connect.ip.requests.total</key>
          <delay>30s</delay>
          <history>7d</history>
          <trends>365d</trends>
          <value_type>UNSIGNED</value_type>
          <units>requests</units>
          <status>ENABLED</status>
          <tags>
            <tag><tag>component</tag><value>masque</value></tag>
