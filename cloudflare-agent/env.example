# CloudBridge AI Monitoring Agent - Environment Variables Example
# Скопируйте этот файл в .env и настройте переменные

# OpenAI API Key (обязательно)
# Получите ключ на https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# CloudBridge Relay Metrics URL
# URL для сбора метрик с CloudBridge Relay
RELAY_METRICS_URL=http://localhost:8080/metrics

# ML Anomaly Detection API
# URL и ключ для ML API детекции аномалий
ML_API_URL=http://localhost:5000/detect_anomaly
ML_API_KEY=your_ml_api_key_here

# SIEM Integration
# URL и ключ для интеграции с SIEM системой
SIEM_API_URL=http://localhost:9000/api/alerts
SIEM_WEBHOOK_URL=http://localhost:9000/webhook
SIEM_API_KEY=your_siem_api_key_here

# Monitoring Configuration
# Интервал проверки в секундах (по умолчанию 5 минут)
CHECK_INTERVAL=300

# Порог для детекции аномалий (0.0 - 1.0)
# Значения выше этого порога считаются аномалиями
ANOMALY_THRESHOLD=0.7

# Дополнительные настройки

# Режим отладки (true/false)
DEBUG=false

# Максимальное количество одновременных соединений
MAX_CONNECTIONS=100

# Таймаут запросов в миллисекундах
REQUEST_TIMEOUT=30000

# Размер буфера для WebSocket сообщений
WS_BUFFER_SIZE=1024

# Интервал очистки старых данных в секундах
CLEANUP_INTERVAL=3600

# Максимальное количество сообщений в истории
MAX_MESSAGE_HISTORY=1000

# Настройки логирования
LOG_LEVEL=info
LOG_FORMAT=json

# Настройки безопасности
# Разрешенные домены для CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Максимальное количество запросов в минуту
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# Настройки уведомлений
# Email для критических алертов
ADMIN_EMAIL=admin@yourdomain.com

# Slack webhook для уведомлений
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Telegram bot token для уведомлений
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Настройки базы данных (опционально)
# Для сохранения истории и метрик
DATABASE_URL=postgresql://user:password@localhost:5432/cloudbridge_ai

# Redis для кэширования (опционально)
REDIS_URL=redis://localhost:6379

# Настройки мониторинга
# Prometheus endpoint для метрик агента
PROMETHEUS_ENDPOINT=/metrics

# Grafana dashboard URL
GRAFANA_DASHBOARD_URL=http://localhost:3000/d/cloudbridge-ai

# Настройки резервного копирования
# Автоматическое резервное копирование конфигурации
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30 