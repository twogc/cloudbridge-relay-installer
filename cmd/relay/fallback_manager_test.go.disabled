func TestFallbackManager_GetConnectionStats(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		MASQUE: struct {
			Enabled         bool     `json:"enabled"`
			ProxyURL        string   `json:"proxy_url"`
			ALPNProtocols   []string `json:"alpn_protocols"`
			FallbackEnabled bool     `json:"fallback_enabled"`
		}{
			Enabled: true,
		},
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
		TCPFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8081",
		},
	}

	manager := NewFallbackManager(testLogger, cfg)

	// Получаем статистику до запуска
	stats := manager.GetConnectionStats()
	assert.NotNil(t, stats)
	assert.False(t, stats["is_running"].(bool))

	// Запускаем manager
	err := manager.Start()
	require.NoError(t, err)
	defer manager.Close()

	// Получаем статистику после запуска
	stats = manager.GetConnectionStats()
	assert.NotNil(t, stats)
	assert.True(t, stats["is_running"].(bool))
	assert.Contains(t, stats, "masque")
	assert.Contains(t, stats, "websocket")
	assert.Contains(t, stats, "tcp")
}

func TestFallbackManager_Close(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		MASQUE: struct {
			Enabled         bool     `json:"enabled"`
			ProxyURL        string   `json:"proxy_url"`
			ALPNProtocols   []string `json:"alpn_protocols"`
			FallbackEnabled bool     `json:"fallback_enabled"`
		}{
			Enabled: true,
		},
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
		TCPFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8081",
		},
	}

	manager := NewFallbackManager(testLogger, cfg)

	// Запускаем manager
	err := manager.Start()
	require.NoError(t, err)
	assert.True(t, manager.isRunning)

	// Закрываем manager
	err = manager.Close()
	assert.NoError(t, err)
	assert.False(t, manager.isRunning)
}

func TestFallbackManager_Close_NotRunning(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{}

	manager := NewFallbackManager(testLogger, cfg)

	// Закрываем manager без запуска
	err := manager.Close()
	assert.NoError(t, err)
}

// Mock соединение для тестов
type mockConn struct {
	remoteAddr string
}

func (m *mockConn) Read(b []byte) (n int, err error) {
	return 0, nil
}

func (m *mockConn) Write(b []byte) (n int, err error) {
	return len(b), nil
}

func (m *mockConn) Close() error {
	return nil
}

func (m *mockConn) LocalAddr() net.Addr {
	return &mockAddr{addr: "127.0.0.1:8080"}
}

func (m *mockConn) RemoteAddr() net.Addr {
	return &mockAddr{addr: m.remoteAddr}
}

func (m *mockConn) SetDeadline(t time.Time) error {
	return nil
}

func (m *mockConn) SetReadDeadline(t time.Time) error {
	return nil
}

func (m *mockConn) SetWriteDeadline(t time.Time) error {
	return nil
}

type mockAddr struct {
	addr string
}

func (m *mockAddr) Network() string {
	return "tcp"
}

func (m *mockAddr) String() string {
	return m.addr
}

// Benchmark тесты
func BenchmarkFallbackManager_DetectBlockingNetwork(b *testing.B) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{}

	manager := NewFallbackManager(testLogger, cfg)

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		manager.DetectBlockingNetwork("192.168.1.1:8080")
	}
}

func BenchmarkFallbackManager_DetermineFallbackStrategy(b *testing.B) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{}

	manager := NewFallbackManager(testLogger, cfg)

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		manager.determineFallbackStrategy("127.0.0.1:8080")
	}
}
