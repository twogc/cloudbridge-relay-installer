func TestNewWebSocketFallback(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)
	assert.NotNil(t, fallback)
	assert.NotNil(t, fallback.upgrader)
	assert.NotNil(t, fallback.connections)
	assert.NotNil(t, fallback.ctx)
	assert.NotNil(t, fallback.cancel)
}

func TestWebSocketFallback_HandleWebSocket(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовый HTTP сервер
	server := httptest.NewServer(http.HandlerFunc(fallback.handleWebSocket))
	defer server.Close()

	// Создаем WebSocket соединение
	wsURL := "ws" + server.URL[4:] + "/ws"
	conn, _, err := websocket.DefaultDialer.Dial(wsURL, nil)
	require.NoError(t, err)
	defer conn.Close()

	// Проверяем, что соединение добавлено
	time.Sleep(100 * time.Millisecond) // Даем время на обработку
	count := fallback.GetConnectionCount()
	assert.Greater(t, count, 0)
}

func TestWebSocketFallback_HandleMASQUEWebSocket(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовый HTTP сервер
	server := httptest.NewServer(http.HandlerFunc(fallback.handleMASQUEWebSocket))
	defer server.Close()

	// Создаем WebSocket соединение с Capsule-Protocol заголовком
	wsURL := "ws" + server.URL[4:] + "/ws/masque"
	headers := http.Header{}
	headers.Set("Capsule-Protocol", "?1")
	
	conn, _, err := websocket.DefaultDialer.Dial(wsURL, headers)
	require.NoError(t, err)
	defer conn.Close()

	// Проверяем, что соединение добавлено
	time.Sleep(100 * time.Millisecond) // Даем время на обработку
	count := fallback.GetConnectionCount()
	assert.Greater(t, count, 0)
}

func TestWebSocketFallback_HandleMASQUEWebSocket_MissingHeader(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовый HTTP запрос без Capsule-Protocol заголовка
	req := httptest.NewRequest("GET", "/ws/masque", nil)
	w := httptest.NewRecorder()

	// Вызываем обработчик
	fallback.handleMASQUEWebSocket(w, req)

	// Проверяем ошибку
	assert.Equal(t, http.StatusBadRequest, w.Code)
	assert.Contains(t, w.Body.String(), "Capsule-Protocol header required")
}

func TestWebSocketFallback_ProcessWebSocketMessage(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовое соединение
	conn := &WebSocketConnection{
		ID:           "test_conn",
		RemoteAddr:   "127.0.0.1:8080",
		CreatedAt:    time.Now(),
		LastActivity: time.Now(),
		IsActive:     true,
	}

	// Создаем mock WebSocket соединение
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		upgrader := websocket.Upgrader{}
		wsConn, err := upgrader.Upgrade(w, r, nil)
		require.NoError(t, err)
		conn.Conn = wsConn
	}))
	defer server.Close()

	// Подключаемся к WebSocket
	wsURL := "ws" + server.URL[4:]
	wsConn, _, err := websocket.DefaultDialer.Dial(wsURL, nil)
	require.NoError(t, err)
	defer wsConn.Close()

	conn.Conn = wsConn

	// Тест обработки текстового сообщения
	err = fallback.processWebSocketMessage(conn, websocket.TextMessage, []byte("test message"))
	assert.NoError(t, err)

	// Тест обработки бинарного сообщения
	err = fallback.processWebSocketMessage(conn, websocket.BinaryMessage, []byte{0x01, 0x02, 0x03})
	assert.NoError(t, err)
}

