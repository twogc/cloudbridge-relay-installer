func TestWebSocketFallback_RemoveConnection(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Добавляем тестовое соединение
	conn := &WebSocketConnection{
		ID:           "test_conn",
		RemoteAddr:   "127.0.0.1:8080",
		CreatedAt:    time.Now(),
		LastActivity: time.Now(),
		IsActive:     true,
	}

	fallback.mu.Lock()
	fallback.connections[conn.ID] = conn
	fallback.mu.Unlock()

	// Проверяем, что соединение добавлено
	count := fallback.GetConnectionCount()
	assert.Equal(t, 1, count)

	// Удаляем соединение
	fallback.removeConnection(conn.ID)

	// Проверяем, что соединение удалено
	count = fallback.GetConnectionCount()
	assert.Equal(t, 0, count)
}

func TestWebSocketFallback_GetConnectionInfo(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Добавляем тестовое соединение
	conn := &WebSocketConnection{
		ID:           "test_conn",
		RemoteAddr:   "127.0.0.1:8080",
		CreatedAt:    time.Now(),
		LastActivity: time.Now(),
		IsActive:     true,
	}

	fallback.mu.Lock()
	fallback.connections[conn.ID] = conn
	fallback.mu.Unlock()

	// Получаем информацию о соединениях
	info := fallback.GetConnectionInfo()
	
	assert.Equal(t, 1, info["total_connections"])
	
	connections, ok := info["connections"].([]map[string]interface{})
	require.True(t, ok)
	require.Len(t, connections, 1)
	
	assert.Equal(t, "test_conn", connections[0]["id"])
	assert.Equal(t, "127.0.0.1:8080", connections[0]["remote_addr"])
	assert.Equal(t, true, connections[0]["is_active"])
}

func TestWebSocketFallback_HandleHealth(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовый HTTP запрос
	req := httptest.NewRequest("GET", "/health", nil)
	w := httptest.NewRecorder()

	// Вызываем обработчик
	fallback.handleHealth(w, req)

	// Проверяем ответ
	assert.Equal(t, http.StatusOK, w.Code)
	assert.Equal(t, "application/json", w.Header().Get("Content-Type"))
	assert.Contains(t, w.Body.String(), "healthy")
	assert.Contains(t, w.Body.String(), "websocket_fallback_enabled")
	assert.Contains(t, w.Body.String(), "connections")
}

func TestWebSocketFallback_Close(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Добавляем тестовое соединение
	conn := &WebSocketConnection{
		ID:           "test_conn",
		RemoteAddr:   "127.0.0.1:8080",
		CreatedAt:    time.Now(),
		LastActivity: time.Now(),
		IsActive:     true,
	}

	fallback.mu.Lock()
	fallback.connections[conn.ID] = conn
	fallback.mu.Unlock()

	// Закрываем fallback
	err := fallback.Close()
	assert.NoError(t, err)

	// Проверяем, что соединения очищены
	count := fallback.GetConnectionCount()
	assert.Equal(t, 0, count)
}

func TestWebSocketConnection_ActivityTracking(t *testing.T) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовое соединение
	conn := &WebSocketConnection{
		ID:           "test_conn",
		RemoteAddr:   "127.0.0.1:8080",
		CreatedAt:    time.Now(),
		LastActivity: time.Now(),
		IsActive:     true,
	}

	initialActivity := conn.LastActivity

	// Обрабатываем сообщение (должно обновить LastActivity)
	err := fallback.processWebSocketMessage(conn, websocket.TextMessage, []byte("test"))
	assert.NoError(t, err)

	// Проверяем, что активность обновилась
	assert.True(t, conn.LastActivity.After(initialActivity))
}

// Benchmark тесты
func BenchmarkWebSocketFallback_ProcessWebSocketMessage(b *testing.B) {
	var testLogger *logger.Logger
	var err error
	testLogger, err = logger.New(logger.Config{Level: logger.DEBUG, JSON: true})
	require.NoError(t, err)
	cfg := &config.Config{
		WebSocketFallback: struct {
			Enabled    bool   `json:"enabled"`
			ListenAddr string `json:"listen_addr"`
		}{
			Enabled:    true,
			ListenAddr: ":8080",
		},
	}

	fallback := NewWebSocketFallback(testLogger, cfg)

	// Создаем тестовое соединение
	conn := &WebSocketConnection{
		ID:           "bench_conn",
		RemoteAddr:   "127.0.0.1:8080",
		CreatedAt:    time.Now(),
		LastActivity: time.Now(),
		IsActive:     true,
	}

	testData := []byte("benchmark message")

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		fallback.processWebSocketMessage(conn, websocket.TextMessage, testData)
	}
}

