{
  "server": {
    "address": ":8080",
    "port": 8080,
    "timeout": "30s",
    "max_tunnels": 1000,
    "ping_interval": "30s",
    "cleanup_interval": "1m"
  },
  "django": {
    "api_endpoint": "http://localhost:8000/api",
    "jwt_secret": "${RELAY_JWT_SECRET}",
    "jwt_expiry": "24h",
    "rest_timeout": "5s",
    "rest_cache_ttl": "5m",
    "rest_max_retries": 3,
    "rest_retry_delay": "100ms"
  },
  "keycloak": {
    "enabled": true,
    "server_url": "http://keycloak:8080",
    "realm": "cloudbridge",
    "client_id": "relay-client",
    "client_secret": "JLowpQ24MDLYkHM7auMYzJSTbp9eCjfM",
    "public_key": "-----BEGIN PUBLIC KEY-----\\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAwYizA49h313kUlnaCD8u\\n3oWgVV0o3mEPpuyhfpp+o/PQNvg6oolodiUhum9uHROvXWT/OPlPLy6fsC3hpprl\\nVII7DiFuRYxtWU24O1Nd66sLt8lNxfTHKH/fwlS4opPHaHZkFzIXrKNeJvTf+kO/h\\nHial8Dut+Z/tIBcwBrPWVll6P/4wpruZlK6dWoNtpac/m6RYyrEMnX+nQ9DZ3S/bS\\nA1SUvRASCWxk/qQQpz/Zp3sgqLNa12h/JztEUuHm1RyshKFvHsTwJuuvmXzzJyAMP\\nPTHr0M0jcdYH64VJFoDSp6xWgqFpuCn3WqevXCVSMfeI1g4TzLDUEBZdesI4PawID\\nAQAB\\n-----END PUBLIC KEY-----",
    "token_validation": {
      "issuer": "https://edge.2gc.ru/realms/cloudbridge",
      "audience": "relay-client",
      "clock_skew": "30s"
    },
    "jwks_cache_ttl": "1h",
    "http_timeout": "30s"
  },
  "security": {
    "tls_enabled": true,
    "cert_file": "${RELAY_TLS_CERT_FILE}",
    "key_file": "${RELAY_TLS_KEY_FILE}",
    "allowed_ips": [
      "0.0.0.0/0"
    ],
    "rate_limit": {
      "enabled": true,
      "requests_per_second": 100,
      "burst": 200
    },
    "mtls": {
      "enabled": false,
      "ca_file": "${RELAY_MTLS_CA_FILE}"
    },
    "cipher_suites": [
      "TLS_AES_256_GCM_SHA384",
      "TLS_CHACHA20_POLY1305_SHA256",
      "TLS_AES_128_GCM_SHA256"
    ],
    "min_tls_version": "1.3",
    "audit": {
      "enabled": true,
      "log_file": "/var/log/relay/audit.log"
    }
  },
  "metrics": {
    "enabled": true,
    "port": 8081,
    "path": "/metrics"
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "output": "file",
    "file": "/var/log/relay/relay.log",
    "max_size": "100MB",
    "max_age": "30d",
    "max_backups": 10
  }
}
