{
    "server": {
        "address": ":8080",
        "port": 8080,
        "timeout": "30s",
        "max_tunnels": 1000,
        "ping_interval": "30s",
        "cleanup_interval": "1m"
    },
    "django": {
        "api_endpoint": "http://localhost:8000/api",
        "jwt_secret": "${RELAY_JWT_SECRET}",
        "jwt_expiry": "24h",
        "rest_timeout": "5s",
        "rest_cache_ttl": "5m",
        "rest_max_retries": 3,
        "rest_retry_delay": "100ms"
    },
    "keycloak": {
        "enabled": true,
        "server_url": "http://localhost:8080",
        "realm": "cloudbridge",
        "client_id": "relay-client",
        "client_secret": "d682s8Sgm3bSMNaD7jgz0Bq2VOkhuc1P",
        "public_key": "zFLJxvhDL-vwl6QXX5kmMjCfTaTuna1BIwLAGboIAmRfFXCjnDQ7qFh-TNg2x8T8fdJqa1Ye_FylY56F9FdT71K5VdowNJM7u79rCMdGenX2vLg_LenCooQz6MT-93pVnUjOaNEgAL1GaEbDkBh1Hia6yEORTu681S-7kpI5LVskY0nhbrI058OPjzUPH26PkbwWrjOFdYrdQgqeCqUjKxo-uJ0CcQCj-nCPITWJ-mW-NPM04Fok_btceI1ltZB869Rcu7-2Jr_kETbe2kKlLlgdHmyhNrVj4zi9erdTEUoiwKCwKd6Bt2LJoyYyRw6WQrY3vjzX1b6g0lmokdBFUQ",
        "token_validation": {
            "issuer": "http://localhost:8080/realms/cloudbridge",
            "audience": "relay-client",
            "clock_skew": "30s"
        },
        "jwks_cache_ttl": "1h",
        "http_timeout": "30s"
    },
    "security": {
        "tls_enabled": true,
        "cert_file": "${RELAY_TLS_CERT_FILE}",
        "key_file": "${RELAY_TLS_KEY_FILE}",
        "allowed_ips": ["0.0.0.0/0"],
        "rate_limit": {
            "enabled": true,
            "requests_per_second": 100,
            "burst": 200
        },
        "mtls": {
            "enabled": false,
            "ca_file": "${RELAY_MTLS_CA_FILE}"
        },
        "cipher_suites": [
            "TLS_AES_256_GCM_SHA384",
            "TLS_CHACHA20_POLY1305_SHA256",
            "TLS_AES_128_GCM_SHA256"
        ],
        "min_tls_version": "1.3",
        "audit": {
            "enabled": true,
            "log_file": "/var/log/relay/audit.log"
        }
    },
    "metrics": {
        "enabled": true,
        "port": 8081,
        "path": "/metrics"
    },
    "logging": {
        "level": "INFO",
        "format": "json",
        "output": "file",
        "file": "/var/log/relay/relay.log",
        "max_size": "100MB",
        "max_age": "30d",
        "max_backups": 10
    }
} 