{
  "server": {
    "address": ":3456",
    "port": 3456,
    "timeout": "30s",
    "max_tunnels": 1000,
    "ping_interval": "30s",
    "cleanup_interval": "1m"
  },
  "django": {
    "api_endpoint": "http://localhost:8000/api/",
    "jwt_secret": "${RELAY_JWT_SECRET}",
    "jwt_expiry": "24h",
    "rest_timeout": "5s",
    "rest_cache_ttl": "5m",
    "rest_max_retries": 3,
    "rest_retry_delay": "100ms"
  },
  "keycloak": {
    "enabled": false,
    "server_url": "${KEYCLOAK_SERVER_URL}",
    "realm": "${KEYCLOAK_REALM}",
    "client_id": "${KEYCLOAK_CLIENT_ID}",
    "client_secret": "${KEYCLOAK_CLIENT_SECRET}",
    "public_key": "-----BEGIN PUBLIC KEY-----\\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAwYizA49h313kUlnaCD8u\\n3oWgVV0o3mEPpuyhfpp+o/PQNvg6oolodiUhum9uHROvXWT/OPlPLy6fsC3hpprl\\nVII7DiFuRYxtWU24O1Nd66sLt8lNxfTHKH/fwlS4opPHaHZkFzIXrKNeJvTf+kO/h\\nHial8Dut+Z/tIBcwBrPWVll6P/4wpruZlK6dWoNtpac/m6RYyrEMnX+nQ9DZ3S/bS\\nA1SUvRASCWxk/qQQpz/Zp3sgqLNa12h/JztEUuHm1RyshKFvHsTwJuuvmXzzJyAMP\\nPTHr0M0jcdYH64VJFoDSp6xWgqFpuCn3WqevXCVSMfeI1g4TzLDUEBZdesI4PawID\\nAQAB\\n-----END PUBLIC KEY-----",
    "token_validation": {
      "issuer": "${KEYCLOAK_ISSUER}",
      "audience": "${KEYCLOAK_AUDIENCE}",
      "clock_skew": "30s"
    },
    "jwks_cache_ttl": "1h",
    "http_timeout": "30s"
  },
  "security": {
    "tls_enabled": false,
    "cert_file": "${RELAY_TLS_CERT_FILE}",
    "key_file": "${RELAY_TLS_KEY_FILE}",
    "allowed_ips": [],
    "rate_limit": {
      "enabled": true,
      "requests_per_second": 100,
      "burst": 200
    },
    "mtls": {
      "enabled": false,
      "ca_file": "${RELAY_MTLS_CA_FILE}"
    },
    "cipher_suites": [],
    "min_tls_version": "1.2",
    "audit": {
      "enabled": true,
      "log_file": "logs/audit.log"
    }
  },
  "metrics": {
    "enabled": true,
    "port": 8081,
    "path": "/metrics"
  },
  "api": {
    "enabled": true,
    "port": 8082,
    "version": "1.0.0"
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout",
    "file": "",
    "max_size": "100MB",
    "max_age": "30d",
    "max_backups": 10
  },
  "protocol": {
    "auto_select": true,
    "preferred": "quic",
    "fallback": "http2",
    "switch_threshold": 0.8,
    "health_check_interval": "30s"
  },
  "quic": {
    "enabled": true,
    "max_streams": 100,
    "keep_alive": true,
    "idle_timeout": "30s",
    "handshake_timeout": "10s"
  },
  "zero_trust": {
    "enabled": true,
    "client_daemon": false,
    "service_discovery": false,
    "auto_reconnect": true,
    "circuit_breaker": {
      "enabled": false,
      "failure_threshold": 5,
      "success_threshold": 3,
      "timeout": "30s",
      "window_size": "60s"
    },
    "health_check": {
      "enabled": true,
      "interval": "30s",
      "timeout": "10s",
      "checks": [
        {
          "name": "server_health",
          "type": "http",
          "url": "http://localhost:3456/health",
          "description": "Server health check"
        },
        {
          "name": "database_ping",
          "type": "ping",
          "host": "localhost",
          "description": "Database connectivity check"
        },
        {
          "name": "custom_check",
          "type": "custom",
          "description": "Custom health check"
        }
      ]
    },
    "rate_limit": {
      "enabled": true,
      "requests_per": 100,
      "window_size": 60
    },
    "authentication": {
      "enabled": true,
      "type": "jwt",
      "jwt_secret": "${RELAY_JWT_SECRET}",
      "keycloak_url": "${KEYCLOAK_SERVER_URL}"
    }
  },
  "ingress": {
    "enabled": true,
    "bastion_mode": false,
    "ip_access_control": {
      "enabled": false,
      "default_allow": true,
      "rules": []
    },
    "tls": {
      "enabled": false,
      "cert_file": "${RELAY_TLS_CERT_FILE}",
      "key_file": "${RELAY_TLS_KEY_FILE}",
      "min_version": "1.2",
      "cipher_suites": [],
      "verify_client_cert": false,
      "client_ca_file": "",
      "insecure_skip_verify": false
    },
    "connection_pool": {
      "max_size": 100,
      "idle_timeout": "90s",
      "max_idle": 10,
      "max_lifetime": "1h"
    },
    "rules": [
      {
        "hostname": "api.example.com",
        "path": "/api/.*",
        "service": "https://localhost:8000"
      },
      {
        "hostname": "ssh.example.com",
        "service": "ssh://localhost:22"
      },
      {
        "hostname": "*",
        "service": "https://localhost:8080"
      }
    ],
    "origin_request": {
      "connect_timeout": "30s",
      "tls_timeout": "10s",
      "tcp_keep_alive": "30s",
      "keep_alive_connections": 100,
      "keep_alive_timeout": "90s",
      "http_host_header": "",
      "origin_server_name": "",
      "no_tls_verify": false,
      "ca_pool": "",
      "disable_chunked_encoding": false,
      "bastion_mode": false,
      "proxy_address": "127.0.0.1",
      "proxy_port": 0,
      "proxy_type": "",
      "http2_origin": true
    }
  }
}
