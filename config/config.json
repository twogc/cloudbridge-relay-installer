{
  "server": {
    "address": "0.0.0.0",
    "port": 9090,
    "timeout": "30s",
    "max_tunnels": 1000,
    "ping_interval": "30s",
    "cleanup_interval": "1m"
  },
  "zitadel": {
    "enabled": true,
    "domain": "${ZITADEL_DOMAIN:-https://zitadel.local}",
    "project_id": "${ZITADEL_PROJECT_ID}",
    "client_id": "${ZITADEL_CLIENT_ID}",
    "client_secret": "${ZITADEL_CLIENT_SECRET}",
    "token_validation": {
      "audience": "cloudbridge-relay",
      "clock_skew": "30s"
    },
    "cache_ttl": "5m",
    "http_timeout": "30s"
  },
  "tenants": {
    "relay-test-tenant": {
      "enabled": true,
      "name": "Relay Test Tenant",
      "description": "Test tenant for DevOps development",
      "limits": {
        "max_tunnels": 10,
        "max_connections": 20,
        "max_bandwidth_mbps": 100,
        "rate_limit_per_second": 500,
        "burst": 100
      },
      "jwt": {
        "issuer": "2gc.ru",
        "audience": "relay-test-tenant",
        "allowed_claims": [
          "tenant_id",
          "user_id",
          "permissions"
        ]
      },
      "allowed_ips": [],
      "allowed_ports": [],
      "features": [
        "tls",
        "jwt",
        "tunneling",
        "p2p",
        "quic"
      ]
    }
  },
  "security": {
    "tls_enabled": false,
    "cert_file": "/app/certs/server.crt",
    "key_file": "/app/certs/server.key",
    "allowed_ips": [],
    "rate_limit": {
      "enabled": true,
      "requests_per_second": 1000,
      "burst": 100
    },
    "mtls": {
      "enabled": true,
      "ca_file": "/app/certs/ca.crt",
      "client_cert_required": true
    },
    "cipher_suites": [
      "TLS_AES_256_GCM_SHA384",
      "TLS_CHACHA20_POLY1305_SHA256"
    ],
    "min_tls_version": "1.2",
    "audit": {
      "enabled": true,
      "log_file": "/app/logs/security.log"
    }
  },
  "metrics": {
    "enabled": true,
    "port": 8084,
    "path": "/metrics"
  },
  "api": {
    "enabled": true,
    "port": 5553,
    "version": "v1"
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "output": "stdout",
    "file": "",
    "max_size": "100MB",
    "max_age": "7d",
    "max_backups": 5
  },
  "protocol": {
    "auto_select": true,
    "preferred": "quic",
    "fallback": "http2",
    "switch_threshold": 0.8,
    "health_check_interval": "30s"
  },
  "quic": {
    "enabled": true,
    "port": 9090,
    "max_streams": 100,
    "keep_alive": true,
    "idle_timeout": "30s",
    "handshake_timeout": "10s"
  },
  "zero_trust": {
    "enabled": true,
    "client_daemon": false,
    "service_discovery": false,
    "auto_reconnect": false,
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 5,
      "success_threshold": 2,
      "timeout": "30s",
      "window_size": "60s"
    },
    "health_check": {
      "enabled": true,
      "interval": "30s",
      "timeout": "5s",
      "checks": [
        {
          "type": "http",
          "url": "http://localhost:9090/health",
          "timeout": "5s"
        },
        {
          "type": "tcp",
          "host": "localhost",
          "port": 51820,
          "timeout": "5s"
        },
        {
          "type": "tcp",
          "host": "localhost",
          "port": 9090,
          "timeout": "5s"
        }
      ]
    },
    "rate_limit": {
      "enabled": true,
      "requests_per": 1000,
      "window_size": 60
    },
    "authentication": {
      "enabled": true,
      "type": "jwt",
      "jwt_secret": ""
    }
  },
  "enhanced_quic": {
    "enabled": true,
    "port": 9092,
    "max_streams": 100,
    "keep_alive": true,
    "idle_timeout": "30s",
    "handshake_timeout": "10s",
    "ddos_protection": true,
    "geographic_routing": false
  },
  "wireguard": {
    "enabled": true,
    "port": 51820,
    "interface": {
      "name": "wg-mesh0",
      "listen_port": 51820,
      "address": "10.100.1.1/24"
    },
    "discovery": {
      "registry_url": "https://auth.2gc.ru/wg/peers",
      "heartbeat_interval": "25s",
      "max_peers": 50
    },
    "mesh": {
      "enabled": true,
      "auto_discovery": true,
      "max_connections": 100,
      "routing_strategy": "hybrid"
    },
    "site_to_site": {
      "enabled": true,
      "corporate_networks": []
    }
  },
  "quantum": {
    "enabled": true,
    "algorithm": "kyber",
    "hybrid_mode": true,
    "key_size": 256,
    "signature_scheme": "dilithium",
    "fallback_enabled": true,
    "key_rotation_days": 30,
    "wireguard": {
      "enabled": true
    },
    "enhanced_quic": {
      "enabled": true
    }
  },
  "ai": {
    "enabled": true,
    "behavior_analysis": {
      "enabled": true,
      "model_path": "",
      "threshold": 0.8,
      "learning_rate": 0.01
    },
    "predictive_security": {
      "enabled": true,
      "confidence": 0.9
    },
    "automated_response": {
      "enabled": true
    },
    "monitoring": {
      "enabled": true,
      "dashboard_url": "",
      "refresh_rate": "30s"
    }
  },
  "cadence": {
    "enabled": true,
    "host_port": "localhost:7933",
    "domain": "cloudbridge",
    "task_list": "relay-task-list"
  },
  "grpc": {
    "enabled": true,
    "port": 8444,
    "tls_enabled": false,
    "cert_file": "/app/certs/tls.crt",
    "key_file": "/app/certs/tls.key",
    "mtls_enabled": false,
    "keepalive_ping": "15s",
    "keepalive_timeout": "10s",
    "max_recv_msg_size": 4194304,
    "max_send_msg_size": 4194304
  }
}
