{
  "jwt": {
    "secret": "YOUR_JWT_SECRET_HERE",
    "issuer": "https://auth.2gc.ru/realms/relay-servers",
    "audience": ["relay-server-client", "p2p-server-client"],
    "expiry": "24h"
  },
  "api": {
    "key": "YOUR_API_KEY_HERE"
  },
  "database": {
    "cassandra": {
      "username": "cassandra",
      "password": "YOUR_CASSANDRA_PASSWORD_HERE"
    }
  },
  "wireguard": {
    "private_key": "YOUR_WIREGUARD_PRIVATE_KEY_HERE",
    "public_key": "YOUR_WIREGUARD_PUBLIC_KEY_HERE"
  },
  "monitoring": {
    "grafana": {
      "admin_user": "admin",
      "admin_password": "YOUR_GRAFANA_PASSWORD_HERE"
    },
    "prometheus": {
      "basic_auth": "admin:YOUR_PROMETHEUS_PASSWORD_HERE"
    }
  },
  "development": {
    "log_level": "info",
    "debug": false
  }
}
