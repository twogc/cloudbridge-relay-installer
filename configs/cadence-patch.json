{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "cadence",
            "env": [
              {
                "name": "CONFIG_TEMPLATE_PATH",
                "value": "/etc/cadence/config/config_template.yaml"
              },
              {
                "name": "CONFIG_FILE_PATH",
                "value": "/etc/cadence/config/docker.yaml"
              }
            ],
            "volumeMounts": [
              {
                "name": "cadence-config-rw",
                "mountPath": "/etc/cadence/config"
              },
              {
                "name": "cadence-config-template",
                "mountPath": "/etc/cadence/config/config_template.yaml",
                "subPath": "config_template.yaml",
                "readOnly": true
              }
            ]
          }
        ],
        "initContainers": null
      }
    }
  }
}


