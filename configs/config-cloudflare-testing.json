{
  "server": {
    "address": "0.0.0.0",
    "port": 6001,
    "timeout": "30s",
    "max_tunnels": 100,
    "ping_interval": "30s",
    "cleanup_interval": "60s"
  },
  "django": {
    "api_endpoint": "",
    "jwt_secret": "${RELAY_JWT_SECRET}",
    "jwt_expiry": "24h",
    "rest_timeout": "5s",
    "rest_cache_ttl": "5m",
    "rest_max_retries": 3,
    "rest_retry_delay": "100ms"
  },
  "keycloak": {
    "enabled": false,
    "server_url": "${KEYCLOAK_SERVER_URL}",
    "realm": "${KEYCLOAK_REALM}",
    "client_id": "${KEYCLOAK_CLIENT_ID}",
    "client_secret": "${KEYCLOAK_CLIENT_SECRET}",
    "public_key": "${KEYCLOAK_PUBLIC_KEY}",
    "fallback_secret": "85Sk/NfLq3gqzCXzmBKbJCpL+f5BssXz3G8dVi3sPiE=",
    "jwks_url": "",
    "token_validation": {
      "issuer": "${KEYCLOAK_ISSUER}",
      "audience": "${KEYCLOAK_AUDIENCE}",
      "clock_skew": "30s"
    },
    "jwks_cache_ttl": "1h",
    "http_timeout": "30s"
  },
  "zitadel": {
    "enabled": false,
    "domain": "${ZITADEL_DOMAIN:-https://zitadel.local}",
    "project_id": "${ZITADEL_PROJECT_ID}",
    "client_id": "${ZITADEL_CLIENT_ID}",
    "client_secret": "${ZITADEL_CLIENT_SECRET}",
    "fallback_secret": "85Sk/NfLq3gqzCXzmBKbJCpL+f5BssXz3G8dVi3sPiE=",
    "token_validation": {
      "audience": "cloudbridge-relay-testing",
      "clock_skew": "30s"
    },
    "cache_ttl": "5m",
    "http_timeout": "30s",
    "tenant_management": {
      "enabled": false,
      "auto_create": false,
      "default_quotas": {
        "max_peers": 5,
        "max_connections": 50,
        "max_tunnels": 10,
        "bandwidth_limit": "100MB",
        "storage_limit": "1GB"
      }
    }
  },
  "security": {
    "tls_enabled": false,
    "cert_file": "${RELAY_TLS_CERT_FILE}",
    "key_file": "${RELAY_TLS_KEY_FILE}",
    "allowed_ips": [],
    "rate_limit": {
      "enabled": true,
      "requests_per_second": 50.0,
      "burst": 500
    },
    "mtls": {
      "enabled": false,
      "ca_file": "${RELAY_MTLS_CA_FILE}"
    },
    "cipher_suites": [],
    "min_tls_version": "TLS1.3",
    "audit": {
      "enabled": true,
      "log_file": "/var/log/relay_testing_audit.log"
    }
  },
  "metrics": {
    "enabled": true,
    "port": 6002,
    "path": "/metrics"
  },
  "api": {
    "enabled": true,
    "port": 6003,
    "version": "v1"
  },
  "http_api": {
    "enabled": true,
    "port": 6004,
    "host": "0.0.0.0",
    "cors_enabled": true,
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 50
    }
  },
  "https_api": {
    "enabled": true,
    "port": 6005,
    "host": "0.0.0.0",
    "tls": {
      "enabled": false,
      "cert_file": "/app/certs/tls.crt",
      "key_file": "/app/certs/tls.key"
    },
    "cors_enabled": true,
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 50
    }
  },
  "logging": {
    "level": "debug",
    "format": "json",
    "output": "stdout",
    "file": "/var/log/relay_testing.log",
    "max_size": "50m",
    "max_age": "24h",
    "max_backups": 3
  },
  "protocol": {
    "auto_select": true,
    "preferred": "quic",
    "fallback": "http",
    "switch_threshold": 0.2,
    "health_check_interval": "30s"
  },
  "quic": {
    "enabled": true,
    "max_streams": 50,
    "keep_alive": true,
    "idle_timeout": "30s",
    "handshake_timeout": "10s",
    "connection_migration": true,
    "multiplexing": true
  },
  "zero_trust": {
    "enabled": true,
    "client_daemon": false,
    "service_discovery": false,
    "auto_reconnect": true,
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 3,
      "success_threshold": 2,
      "timeout": "30s",
      "window_size": "60s"
    },
    "health_check": {
      "enabled": true,
      "interval": "30s",
      "timeout": "10s",
      "checks": []
    },
    "rate_limit": {
      "enabled": true,
      "requests_per": 50,
      "window_size": 60
    },
    "authentication": {
      "enabled": false,
      "type": "jwt",
      "jwt_secret": "",
      "keycloak_url": ""
    }
  },
  "enhanced_quic": {
    "enabled": true,
    "max_streams": 50,
    "keep_alive": true,
    "idle_timeout": "30s",
    "handshake_timeout": "10s",
    "ddos_protection": false,
    "geographic_routing": false,
    "keycloak_integration": false
  },
  "ice_stun_turn": {
    "enabled": true,
    "stun_servers": [
      "stun.l.google.com:19302",
      "stun1.l.google.com:19302"
    ],
    "turn_servers": [],
    "ice_timeout": "30s",
    "connection_timeout": "10s",
    "gathering_timeout": "5s",
    "candidate_types": [
      "host",
      "srflx",
      "relay"
    ]
  },
  "masque": {
    "enabled": true,
    "proxy_url": "https://auth.2gc.ru:8443",
    "alpn_protocols": [
      "h3",
      "h3-29",
      "h3-28",
      "h3-27"
    ],
    "fallback_enabled": true
  },
  "wireguard": {
    "enabled": false,
    "interface": {
      "name": "wg0",
      "listen_port": 51821,
      "address": "10.100.2.1/24"
    },
    "discovery": {
      "registry_url": "https://registry.cloudbridge.com",
      "heartbeat_interval": "30s",
      "max_peers": 10
    },
    "mesh": {
      "enabled": false,
      "auto_discovery": false,
      "max_connections": 20,
      "routing_strategy": "hybrid"
    },
    "site_to_site": {
      "enabled": false,
      "corporate_networks": []
    }
  },
  "quantum": {
    "enabled": false,
    "algorithm": "kyber",
    "hybrid_mode": false,
    "key_size": 7680,
    "signature_scheme": "dilithium3",
    "fallback_enabled": false,
    "key_rotation_days": 30,
    "wireguard": { "enabled": false },
    "enhanced_quic": { "enabled": false }
  },
  "ai": {
    "enabled": false,
    "behavior_analysis": {
      "enabled": false,
      "model_path": "",
      "threshold": 0.8,
      "learning_rate": 0.01
    },
    "predictive_security": {
      "enabled": false,
      "confidence": 0.9
    },
    "automated_response": {
      "enabled": false
    },
    "monitoring": {
      "enabled": false,
      "dashboard_url": "http://localhost:3000",
      "refresh_rate": "30s"
    }
  },
  "cadence": {
    "enabled": false,
    "host_port": "cadence:7933",
    "domain": "cloudbridge-testing",
    "task_list": "testing-tasks"
  },
  "cloudflare": {
    "enabled": true,
    "testing_mode": true,
    "tunnel_id": "${CLOUDFLARE_TUNNEL_ID}",
    "credentials_file": "/etc/cloudflared/credentials.json",
    "config_file": "/etc/cloudflared/config.yml",
    "log_level": "debug",
        "metrics_port": 6006,
        "health_check_port": 6007
  }
}
