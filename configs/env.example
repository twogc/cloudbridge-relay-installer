# VK Cloud OpenStack Authentication
# Скопируйте этот файл в .env и заполните вашими данными

export OS_AUTH_URL=https://infra.mail.ru:35357/v3/
export OS_USERNAME=your_email@domain.com
export OS_PASSWORD=your_password
export OS_PROJECT_NAME=your_project_name
export OS_PROJECT_ID=your_project_id
export OS_REGION_NAME=RegionOne
export OS_INTERFACE=public
export OS_IDENTITY_API_VERSION=3
export OS_AUTH_TYPE=password
export OS_USER_DOMAIN_NAME=users
export OS_PROJECT_DOMAIN_NAME=users

# Пример заполнения:
# export OS_USERNAME=info@2gc.ru
# export OS_PASSWORD=your_secure_password
# export OS_PROJECT_NAME=mcs2943222211
# export OS_PROJECT_ID=8530029fa7b64199b2ad87c18d4620df 

# ------------------------------------------------------------
# CloudBridge Relay — локальные секреты/переменные окружения
# ------------------------------------------------------------

# JWT секрет для P2P API (используется сервером при старте)
# Пример: раскомментируйте и задайте значение
# export JWT_SECRET="change-me-strong"

# Для удобства можно сохранить в .env:
#   cp configs/env.example .env
#   echo 'export JWT_SECRET="change-me-strong"' >> .env