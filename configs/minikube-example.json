{
  "server": {
    "address": ":8443",
    "port": 8443,
    "timeout": "30s",
    "max_tunnels": 100,
    "ping_interval": "30s",
    "cleanup_interval": "60s"
  },
  "security": {
    "tls_enabled": false,
    "cert_file": "",
    "key_file": ""
  },
  "metrics": {
    "enabled": true,
    "port": 5551,
    "path": "/metrics"
  },
  "api": {
    "enabled": true,
    "port": 8080,
    "version": "v1"
  },
  "grpc": {
    "enabled": true,
    "port": 8444,
    "tls_enabled": false,
    "keepalive_ping": "15s",
    "keepalive_timeout": "10s"
  },
  "kubernetes": {
    "clusters": [
      {
        "id": "minikube",
        "api_server_url": "https://192.168.49.2:8443",
        "ca": "",
        "client_cert": "",
        "client_key": "",
        "skip_tls_verify": true
      }
    ],
    "policies": [
      {
        "tenant_id": "default",
        "user_id": "",
        "groups": ["users"],
        "rules": [
          {
            "name": "minikube-full-access",
            "verbs": ["get", "list", "watch", "create", "update", "patch", "delete"],
            "api_groups": ["", "apps", "extensions"],
            "resources": ["*"],
            "namespaces": []
          },
          {
            "name": "exec-logs-access",
            "verbs": ["exec", "attach", "logs", "portforward"],
            "api_groups": [""],
            "resources": ["pods", "pods/exec", "pods/attach", "pods/log", "pods/portforward"],
            "namespaces": []
          }
        ]
      }
    ]
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout"
  }
}
