{
  "name": "cloudbridge-relay-api",
  "description": "CloudBridge Relay gRPC/HTTP API - Back-channel OIDC client for service-to-service authentication",
  "app_type": "Web Application",
  "auth_method": "Client Secret (Basic)",
  "grant_types": [
    "Client Credentials",
    "Authorization Code"
  ],
  "response_types": [
    "Code"
  ],
  "redirect_uris": [
    "https://b1.2gc.space/auth/callback",
    "https://relay.2gc.space/auth/callback",
    "https://*.relay.2gc.space/auth/callback",
    "http://localhost:8080/auth/callback"
  ],
  "post_logout_redirect_uris": [
    "https://b1.2gc.space/",
    "https://relay.2gc.space/"
  ],
  "access_token_type": "JWT",
  "access_token_role_assertion": true,
  "id_token_role_assertion": true,
  "dev_mode": false,
  "scopes": [
    "openid", 
    "profile",
    "email",
    "relay.api",
    "urn:zitadel:iam:org:project:id:zitadel:aud"
  ]
}
