{
  "name": "cloudbridge-relay-spa",
  "description": "CloudBridge Relay Web UI - Front-channel SPA/PWA OIDC client with PKCE for kubectl login",
  "app_type": "Single Page Application (SPA)",
  "auth_method": "PKCE",
  "grant_types": [
    "Authorization Code",
    "Device Code"
  ],
  "response_types": [
    "Code"
  ],
  "redirect_uris": [
    "https://relay.2gc.space/ui/callback",
    "https://b1.2gc.space/ui/callback",
    "http://localhost:3000/callback",
    "http://localhost:8080/callback",
    "http://localhost:9999/callback",
    "urn:ietf:wg:oauth:2.0:oob"
  ],
  "post_logout_redirect_uris": [
    "https://relay.2gc.space/ui/",
    "https://b1.2gc.space/ui/",
    "http://localhost:3000/",
    "http://localhost:8080/"
  ],
  "access_token_type": "JWT",
  "access_token_role_assertion": true,
  "id_token_role_assertion": true,
  "dev_mode": true,
  "allow_localhost_redirect": true,
  "scopes": [
    "openid",
    "profile", 
    "email",
    "offline_access",
    "relay.api",
    "relay.k8s",
    "urn:zitadel:iam:org:project:id:zitadel:aud"
  ]
}
