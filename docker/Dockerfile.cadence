# Dockerfile для сборки образа с Cadence
FROM golang:1.21-alpine AS builder

# Устанавливаем зависимости
RUN apk add --no-cache git make gcc musl-dev

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем go.mod и go.sum
COPY go.mod go.sum ./

# Загружаем зависимости
RUN go mod download

# Копируем исходный код
COPY . .

# Собираем приложение
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o cloudbridge-relay ./cmd/relay

# Финальный образ
FROM alpine:latest

# Устанавливаем необходимые пакеты
RUN apk --no-cache add ca-certificates tzdata

# Создаем пользователя
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем бинарный файл
COPY --from=builder /app/cloudbridge-relay .

# Копируем конфигурационные файлы
COPY configs/ ./configs/

# Устанавливаем права
RUN chown -R appuser:appgroup /app

# Переключаемся на непривилегированного пользователя
USER appuser

# Открываем порты
EXPOSE 8080 8081 7933 7934

# Команда по умолчанию
CMD ["./cloudbridge-relay"]
