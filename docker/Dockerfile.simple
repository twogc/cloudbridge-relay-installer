# Minimal Dockerfile using pre-built binary
FROM alpine:latest

# Install necessary dependencies
RUN apk --no-cache add ca-certificates tzdata

# Create app directory
WORKDIR /app

# Copy the pre-built binary
COPY cloudbridge-relay .

# Make it executable
RUN chmod +x cloudbridge-relay

# Expose ports based on actual configuration
EXPOSE 5550 5551 5552 5553 8443 9090 9092 19302

# Run the application
CMD ["./cloudbridge-relay"]