# =========================================================
# CloudBridge QUIC Service - Enhanced Multi-stage Build
# =========================================================

# ---------- Stage 1: Go Builder ----------
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    git \
    build-base \
    linux-headers \
    ca-certificates \
    tzdata

WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build arguments
ARG VERSION=dev
ARG BUILD_TIME
ARG GIT_COMMIT
ARG CGO_ENABLED=1

# Build the QUIC service binary
RUN CGO_ENABLED=${CGO_ENABLED} GOOS=linux GOARCH=amd64 go build \
    -ldflags "-X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME} -X main.GitCommit=${GIT_COMMIT} -s -w" \
    -trimpath \
    -o cloudbridge-quic \
    ./cmd/quic-service

# ---------- Stage 2: Production Image ----------
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    bash \
    curl \
    netcat-openbsd \
    && rm -rf /var/cache/apk/*

# Create user and directories
RUN addgroup -g 1000 cloudbridge && \
    adduser -D -s /bin/bash -u 1000 -G cloudbridge cloudbridge && \
    mkdir -p \
        /app/configs \
        /app/logs \
        /var/log/cloudbridge-quic \
        /tmp/cloudbridge

# Copy binary and configs
COPY --from=builder /app/cloudbridge-quic /usr/local/bin/cloudbridge-quic
COPY --from=builder /app/configs/enhanced_quic.yaml /app/configs/enhanced_quic.yaml

# Set permissions
RUN chmod +x /usr/local/bin/cloudbridge-quic && \
    chown -R cloudbridge:cloudbridge /app /var/log/cloudbridge-quic /tmp/cloudbridge

# Switch to non-root user
USER cloudbridge
WORKDIR /app

# Expose ports
EXPOSE 9090/tcp 9090/udp 8084/tcp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/health || exit 1

# Environment variables
ENV CONFIG_PATH=/app/configs/enhanced_quic.yaml \
    LOG_LEVEL=info \
    GIN_MODE=release \
    TZ=UTC \
    QUIC_ENABLED=true

# Labels
LABEL maintainer="CloudBridge Team" \
      version="${VERSION}" \
      description="CloudBridge QUIC Service for high-performance networking" \
      org.opencontainers.image.title="CloudBridge QUIC Service" \
      org.opencontainers.image.description="QUIC protocol implementation for enhanced performance" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.revision="${GIT_COMMIT}"

# Entrypoint
ENTRYPOINT ["/usr/local/bin/cloudbridge-quic"]
CMD ["--config", "/app/configs/enhanced_quic.yaml"]

