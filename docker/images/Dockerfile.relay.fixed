# Multi-stage build для CloudBridge Relay WireGuard
FROM golang:1.25.12-alpine AS builder

# Установка зависимостей для сборки
RUN apk add --no-cache \
    git \
    build-base \
    linux-headers \
    wireguard-tools

# Установка рабочей директории
WORKDIR /app

# Копирование go mod файлов
COPY go.mod go.sum ./

# Скачивание зависимостей
RUN go mod download

# Копирование исходного кода
COPY . .

# Сборка приложения
ARG VERSION=dev
ARG BUILD_TIME
ARG GIT_COMMIT

RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags "-X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME} -X main.GitCommit=${GIT_COMMIT}" \
    -o cloudbridge-relay ./cmd/relay

# Сборка WireGuard-go с альтернативными источниками
RUN echo "nameserver 8.8.8.8" > /etc/resolv.conf && \
    echo "nameserver 8.8.4.4" >> /etc/resolv.conf && \
    echo "nameserver 1.1.1.1" >> /etc/resolv.conf && \
    (git clone https://github.com/WireGuard/wireguard-go.git /tmp/wireguard-go || \
     git clone https://git.zx2c4.com/wireguard-go.git /tmp/wireguard-go || \
     echo "Fallback: using system wireguard-tools") && \
    if [ -d "/tmp/wireguard-go" ]; then \
        cd /tmp/wireguard-go && \
        make && \
        cp wireguard-go /app/; \
    else \
        echo "WireGuard-go build failed, will use system tools"; \
    fi

# Финальный образ
FROM alpine:3.18

# Установка необходимых пакетов
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    iproute2 \
    wireguard-tools \
    iptables \
    bash \
    curl \
    netcat-openbsd \
    && rm -rf /var/cache/apk/*

# Создание пользователя
RUN addgroup -g 1000 cloudbridge && \
    adduser -D -s /bin/bash -u 1000 -G cloudbridge cloudbridge

# Создание необходимых директорий
RUN mkdir -p \
    /app/configs \
    /app/logs \
    /etc/wireguard \
    /var/run/wireguard \
    /var/log/cloudbridge-relay

# Копирование бинарных файлов
COPY --from=builder /app/cloudbridge-relay /usr/local/bin/

# Копирование wireguard-go если доступен
RUN if [ -f "/app/wireguard-go" ]; then \
        cp /app/wireguard-go /usr/local/bin/ && \
        chmod +x /usr/local/bin/wireguard-go; \
    else \
        echo "Using system wireguard-tools"; \
    fi

# Установка прав
RUN chmod +x /usr/local/bin/cloudbridge-relay && \
    chown -R cloudbridge:cloudbridge /app /etc/wireguard /var/run/wireguard /var/log/cloudbridge-relay

# Копирование конфигурации по умолчанию
COPY configs/config.json /app/configs/config.json

# Переключение на пользователя
USER cloudbridge

# Рабочая директория
WORKDIR /app

# Открытие портов
EXPOSE 80 8080 8081 8082 9090 51820/udp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Переменные окружения
ENV CONFIG_PATH=/app/configs/config.json
ENV LOG_LEVEL=info
ENV WIREGUARD_ENABLED=true

# Команда запуска
ENTRYPOINT ["/usr/local/bin/cloudbridge-relay"]
CMD ["--config", "/app/configs/config.json"]
