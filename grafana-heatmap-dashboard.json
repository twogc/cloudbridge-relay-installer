{
  "dashboard": {
    "id": null,
    "title": "CloudBridge PoP Cost Matrix (Argo-style)",
    "tags": ["cloudbridge", "routing", "inter-pop"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "PoP Cost Matrix Heatmap",
        "type": "heatmap",
        "targets": [
          {
            "expr": "cloudbridge_pop_cost_matrix{pop_src, pop_dst}",
            "legendFormat": "{{pop_src}} → {{pop_dst}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "palette-classic",
              "palette": {
                "name": "red-yellow-green"
              }
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "RTT Distribution by PoP Pair",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, cloudbridge_pop_rtt_seconds_bucket{pop_src, pop_dst}) * 1000",
            "legendFormat": "p95 RTT {{pop_src}}→{{pop_dst}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Packet Loss by PoP Pair",
        "type": "stat",
        "targets": [
          {
            "expr": "cloudbridge_pop_packet_loss{pop_src, pop_dst} * 100",
            "legendFormat": "Loss % {{pop_src}}→{{pop_dst}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 4,
        "title": "Active Routes Timeline",
        "type": "timeseries",
        "targets": [
          {
            "expr": "cloudbridge_active_routes_total{pop_src, pop_dst}",
            "legendFormat": "{{pop_src}}→{{pop_dst}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "Handover Events",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(cloudbridge_handover_events_total[5m])",
            "legendFormat": "Handovers/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        },
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
