{
  "dashboard": {
    "id": null,
    "title": "CloudBridge AI System Dashboard",
    "tags": ["cloudbridge", "ai", "monitoring"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "AI Connections Processed",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(ai_connections_processed_total[5m])",
            "legendFormat": "Connections/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 2,
        "title": "Anomaly Detection Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "rate(ai_anomalies_detected_total[5m])",
            "legendFormat": "{{severity}} - {{type}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Anomalies/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 3,
        "title": "AI Processing Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ai_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(ai_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Latency (seconds)",
            "min": 0
          }
        ]
      },
      {
        "id": 4,
        "title": "Cache Hit Rate",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(ai_cache_hits_total[5m]) / (rate(ai_cache_hits_total[5m]) + rate(ai_cache_misses_total[5m])) * 100",
            "legendFormat": "Hit Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 90}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 5,
        "title": "AI Service Health",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "ai_service_health",
            "legendFormat": "{{service}} - {{component}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "Unhealthy"}}, "type": "value"},
              {"options": {"1": {"text": "Healthy"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 6,
        "title": "Circuit Breaker Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "ai_circuit_breaker_state",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "red", "value": 1},
                {"color": "yellow", "value": 2}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "Closed"}}, "type": "value"},
              {"options": {"1": {"text": "Open"}}, "type": "value"},
              {"options": {"2": {"text": "Half-Open"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 7,
        "title": "Load Predictions",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(ai_load_predictions_total[5m])",
            "legendFormat": "{{horizon}}h horizon",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Predictions/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 8,
        "title": "Route Optimizations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(ai_routes_optimized_total[5m])",
            "legendFormat": "{{protocol}} - {{optimization_type}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Optimizations/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 9,
        "title": "AI Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "ai_memory_usage_bytes / 1024 / 1024",
            "legendFormat": "{{component}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Memory (MB)",
            "min": 0
          }
        ]
      },
      {
        "id": 10,
        "title": "AI CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "ai_cpu_usage_percent",
            "legendFormat": "{{component}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "CPU Usage (%)",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 11,
        "title": "Model Accuracy",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "ai_anomaly_detection_accuracy * 100",
            "legendFormat": "Anomaly Detection",
            "refId": "A"
          },
          {
            "expr": "ai_load_prediction_accuracy * 100",
            "legendFormat": "Load Prediction",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "Accuracy (%)",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 12,
        "title": "Cost Savings",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "ai_cost_savings_total",
            "legendFormat": "{{optimization_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "currencyUSD"
          }
        }
      }
    ]
  }
}
