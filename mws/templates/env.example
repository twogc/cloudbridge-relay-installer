# Copy to /opt/cloudbridge/.env on the VM. Do not commit real values.
# Generate secrets: openssl rand -hex 32

POSTGRES_PASSWORD=change-me
ZITADEL_MASTERKEY=change-me-32-chars-minimum-length!!
ZITADEL_ADMIN_USER=admin@cloudbridge.local
ZITADEL_ADMIN_PASSWORD=change-me
ZITADEL_DOMAIN=localhost

# Filled after Zitadel project setup (Step 2+ marketplace wizard)
ZITADEL_PROJECT_ID=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Override relay image if using a private registry
RELAY_IMAGE=twogc/cloudbridge-relay:latest
