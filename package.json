{
  "name": "@twogc/cloudbridge-relay",
  "version": "1.0.0",
  "description": "Enterprise-grade high-performance relay server with WireGuard integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "docs": "typedoc src/index.ts --out docs",
    "example": "node dist/examples/basic.js"
  },
  "keywords": [
    "relay",
    "wireguard",
    "quic",
    "vpn",
    "p2p",
    "mesh",
    "enterprise",
    "security",
    "networking",
    "cloudflare",
    "post-quantum",
    "cryptography"
  ],
  "author": {
    "name": "2GC Team",
    "email": "dev@2gc.ru",
    "url": "https://2gc.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twogc/cloudbridge-relay-installer.git"
  },
  "bugs": {
    "url": "https://github.com/twogc/cloudbridge-relay-installer/issues"
  },
  "homepage": "https://github.com/twogc/cloudbridge-relay-installer#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "chalk": "^5.6.0",
    "commander": "^11.1.0",
    "dotenv": "^16.6.1",
    "inquirer": "^12.9.4",
    "node-forge": "^1.3.1",
    "ora": "^7.0.1",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.19.13",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.25.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cloudbridge-relay": "./dist/cli.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
