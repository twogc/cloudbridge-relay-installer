  <triggers>
    <!-- ======================== Critical Triggers ======================== -->
    <trigger>
       <uuid>ff6397542fa74b579103827fe69c215f</uuid>
      <expression>min(/CloudBridge Relay Template/cloudbridge.relay.connections,5m)&lt;{$CB.RELAY.MIN_CONN}</expression>
      <name>CloudBridge Relay: no active connections</name>
      <priority>HIGH</priority>
      <description>No active relay connections for 5m (threshold: {$CB.RELAY.MIN_CONN}).</description>
      <status>ENABLED</status>
      <manual_close>NO</manual_close>
      <tags>
        <tag><tag>component</tag><value>relay</value></tag>
        <tag><tag>scope</tag><value>availability</value></tag>
      </tags>
    </trigger>

    <trigger>
       <uuid>0e64291440864171950063701836144d</uuid>
      <expression>nodata(/CloudBridge Relay Template/cloudbridge.relay.connections,{$CB.NODATA.WINDOW})=1</expression>
      <name>CloudBridge Relay: no data</name>
      <priority>HIGH</priority>
      <description>No data received for relay connections for {$CB.NODATA.WINDOW}.</description>
      <status>ENABLED</status>
      <manual_close>NO</manual_close>
      <tags>
        <tag><tag>component</tag><value>relay</value></tag>
        <tag><tag>scope</tag><value>monitoring</value></tag>
      </tags>
    </trigger>

    <trigger>
       <uuid>35a23909f0c84498b24d213e3ae5fadd</uuid>
      <expression>last(/CloudBridge Relay Template/cloudbridge.ai.status)&lt;&gt;"{$CB.AI.STATUS}"</expression>
      <name>AI Service is not "{$CB.AI.STATUS}"</name>
      <priority>HIGH</priority>
      <description>AI service status differs from expected "{$CB.AI.STATUS}".</description>
      <status>ENABLED</status>
      <manual_close>NO</manual_close>
      <tags>
        <tag><tag>component</tag><value>ai</value></tag>
        <tag><tag>scope</tag><value>availability</value></tag>
      </tags>
    </trigger>

    <trigger>
       <uuid>1d03e26d79e143f8952b623c26b09769</uuid>
      <expression>avg(/CloudBridge Relay Template/cloudbridge.system.cpu.usage,5m)&gt;{$CB.CPU.HIGH}</expression>
