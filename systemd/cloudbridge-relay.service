[Unit]
Description=CloudBridge Relay Production Stack
Documentation=https://github.com/twogc/cloudbridge-relay-installer
After=docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /usr/local/bin/relay_start_wrapper.sh
ExecStop=/usr/bin/docker-compose -f /home/ubuntu/cloudbridge-relay-installer/docker-compose.yml down
ExecReload=/usr/bin/docker-compose -f /home/ubuntu/cloudbridge-relay-installer/docker-compose.yml restart
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=30

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/cloudbridge-relay-installer

[Install]
WantedBy=multi-user.target 