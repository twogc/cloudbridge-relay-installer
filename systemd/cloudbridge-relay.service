[Unit]
Description=CloudBridge Relay Server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cloudbridge-relay
Group=cloudbridge-relay
WorkingDirectory=/var/lib/cloudbridge-relay
ExecStart=/usr/local/bin/cloudbridge-relay
Restart=always
RestartSec=1
Environment=GOMAXPROCS=4
Environment=GODEBUG=netdns=go

# Security hardening
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=1048576
LimitNPROC=65535
MemoryLimit=1G
CPUQuota=80%

[Install]
WantedBy=multi-user.target 