[Unit]
Description=Enhanced Lynis Security Audit with Advanced Checks
Documentation=https://github.com/twogc/cloudbridge-relay-installer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/ubuntu/cloudbridge-relay-installer
ExecStart=/bin/bash /home/ubuntu/cloudbridge-relay-installer/scripts/security/enhanced_lynis_audit.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800
TimeoutStopSec=30
Restart=no

# Безопасность
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/lynis /var/lib/lynis-telegram /home/ubuntu/cloudbridge-relay-installer/logs

[Install]
WantedBy=multi-user.target 