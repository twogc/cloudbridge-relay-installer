[Unit]
Description=Security Monitor with Telegram Notifications
Documentation=https://github.com/cloudbridge/relay-installer
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/ubuntu/cloudbridge-relay-installer
ExecStart=/home/ubuntu/cloudbridge-relay-installer/scripts/security/security_monitor.sh --continuous
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=security-monitor

# Безопасность
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/security-monitor /var/log

# Ограничения ресурсов
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target 