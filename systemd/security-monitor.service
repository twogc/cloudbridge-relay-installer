[Unit]
Description=CloudBridge Relay Security Monitor
Documentation=https://github.com/twogc/cloudbridge-relay-installer
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/cloudbridge-relay-installer
ExecStart=/usr/bin/bash /home/ubuntu/cloudbridge-relay-installer/scripts/security_monitor.sh --continuous
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/cloudbridge-relay-installer/logs

[Install]
WantedBy=multi-user.target 