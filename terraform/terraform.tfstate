    {
      "mode": "managed",
      "type": "vkcs_cloud_monitoring",
      "name": "relay_ddos_monitoring",
      "provider": "provider[\"registry.terraform.io/vk-cs/vkcs\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "41fed7914bc64c30818d37888c5ab28a",
            "image_id": "769e4c02-680c-420e-874b-6fd41f2da6be",
            "region": "RegionOne",
            "script": "#!/bin/bash\n\nset -xueo pipefail\n\nfunction _error {\n\techo \"ERROR: $1\"\n\texit 127\n}\n\nfunction detect_os_name {\n\tlocal name\n\tname=$(grep '^ID=' /etc/os-release | awk -F= '{ print tolower($2) }')\n\techo \"${name//\\\"}\"\n}\n\nfunction detect_os_version {\n\tlocal version\n\tversion=$(grep '^VERSION_ID=' /etc/os-release | awk -F= '{ print $2 }')\n\techo \"${version//\\\"}\" | awk -F. '{ print $1 }'\n}\n\nfunction detect_redos_version {\n\tlocal version\n\tversion=$(grep '^VERSION_ID=' /etc/os-release | awk -F= '{ print $2 }')\n\techo \"${version//\\\"}\" | awk -F. '{ print $1\".\"$2 }'\n}\n\nfunction detect_astra_os_version {\n\tlocal version\n\tversion=$(grep '^VERSION_ID=' /etc/os-release | awk -F= '{ print $2 }')\n\techo \"${version//\\\"}\" | awk -F_ '{ print $1 }'\n}\n\nfunction install_certificates_common_deb {\n\tlocal cert_content=\"$1\"\n\tlocal cert_dir=\"/usr/local/share/ca-certificates\"\n\tlocal cert_file_prefix=\"local-ca-bundle\"\n\techo \"$cert_content\" | base64 -d | csplit -z -f \"$cert_dir/$cert_file_prefix-\" -b \"%02d.crt\" - '/-----BEGIN CERTIFICATE-----/' {*}\n\tupdate-ca-certificates\n}\n\nfunction install_certificates_common_rpm {\n\tlocal cert_content=\"$1\"\n\tlocal cert_dir=\"/etc/pki/ca-trust/source/anchors\"\n\tlocal cert_file=\"local-ca-bundle.pem\"\n\techo \"$cert_content\" | base64 -d \u003e \"$cert_dir/$cert_file\"\n\tupdate-ca-trust\n}\n\nfunction install_certificates_opensuse {\n\tlocal cert_content=\"$1\"\n\tlocal cert_dir=\"/etc/pki/trust/anchors\"\n\tlocal cert_file=\"local-ca-bundle.pem\"\n\techo \"$cert_content\" | base64 -d \u003e \"$cert_dir/$cert_file\"\n\tupdate-ca-certificates\n}\n\nfunction install_ubuntu() {\n\tlocal version\n\tversion=$(detect_os_version)\n\tcase \"$version\" in\n\t\t16|18|19|20|22|24)\n\t\t\t;;\n\t\t*)\n\t\t\t_error \"unsupported version of ubuntu: $version\";;\n\tesac\n\n\tlocal f\n\tf=$(mktemp --suffix=.deb)\n\t\n\tcurl -L -o \"$f\" \"$1\"\n\t\n\tapt install -y \"$f\"\n}\n\nfunction install_astra() {\n\tlocal version\n\tversion=$(detect_astra_os_version)\n\tcase \"$version\" in\n\t\t\"1.7\")\n\t\t\t;;\n\t\t*)\n\t\t\t_error \"unsupported version of astra linux: $version\";;\n\tesac\n\n\tif ! which curl; then\n\t\tapt-get -y update \u0026\u0026 apt-get -y install curl\n\tfi\n\n\tlocal f\n\tf=$(mktemp --suffix=.deb)\n\t\n\tcurl -L -o \"$f\" \"$1\"\n\t\n\tapt install -y \"$f\"\n}\n\nfunction install_alt() {\n\tlocal version\n\tversion=$(detect_os_version)\n\tcase \"$version\" in\n\t\t\"p10\"|8|10)\n\t\t\t;;\n\t\t*)\n\t\t\t_error \"unsupported version of altlinux: $version\";;\n\tesac\n\n  if ! which curl\n  then\n    if [ \"$EUID\" -eq 0 ]\n    then\n      apt-get -y update \u0026\u0026 apt-get -y install curl\n    else\n      sudo apt-get -y update \u0026\u0026 sudo apt-get -y install curl\n    fi\n  fi\n\n\tif [ ! -d \"/usr/lib/systemd/system/\" ]\n\tthen\n\t\tmkdir \"/usr/lib/systemd/system/\"\n\tfi\n\n\tlocal f\n\tf=$(mktemp --suffix=.rpm)\n\t\n\tcurl -L -o \"$f\" \"$1\"\n\t\n\n\tif [ \"$EUID\" -eq 0 ]\n\tthen\n\t\tapt-get -y install \"$f\"\n\telse\n\t\tsudo apt-get -y install \"$f\"\n\tfi\n}\n\nfunction install_debian() {\n\tlocal version\n\tversion=$(detect_os_version)\n\tcase \"$version\" in\n\t\t12|11|10|9)\n\t\t\t;;\n\t\t*)\n\t\t\t_error \"unsupported version of debian: $version\";;\n\tesac\n\n\tif ! which curl; then\n\t\tapt-get -y update \u0026\u0026 apt-get -y install curl\n\tfi\n\n\tlocal f\n\tf=$(mktemp --suffix=.deb)\n\t\n\tcurl -L -o \"$f\" \"$1\"\n\t\n\tapt install -y \"$f\"\n}\n\nfunction install_centos() {\n\tlocal version\n\tversion=$(detect_os_version)\n\tlocal pkgmanager\n\tcase \"$version\" in\n\t\t7)\n\t\t\tpkgmanager='yum';;\n\n\t\t8 | 9)\n\t\t\tpkgmanager='dnf';;\n\t\t*)\n\t\t\t_error \"unsupported version of centos: $version\";;\n\tesac\n\tlocal f\n\tf=$(mktemp --suffix=.rpm)\n\t\n\tcurl -L -o \"$f\" \"$1\"\n\t\n\tname=$(sudo rpm -qp \"$f\")\n\tif yum list installed $name \u003e/dev/null 2\u003e\u00261; then\n\t\techo \"Package $name is already installed\";\n\telse\n\t\n\t\tfor i in {1..3}; do sudo \"$pkgmanager\" install -y --disablerepo=\"*\" \"$1\" \u0026\u0026 break || sudo rpm -ivh \"$1\" \u0026\u0026 break || sleep 60; done\n\t\n\tfi\n}\n\nfunction install_redos() {\n\tlocal version\n\tversion=$(detect_redos_version)\n\tlocal pkgmanager\n\tcase \"$version\" in\n\t\t\"7.3\"|\"8.0\")\n\t\t\tpkgmanager='dnf';;\n\t\t*)\n\t\t\t_error \"unsupported version of redos: $version\";;\n\tesac\n  \n  for i in {1..3}; do \"$pkgmanager\" install -y --disablerepo=\"*\" \"$1\" \u0026\u0026 break || rpm -ivh \"$1\" \u0026\u0026 break || sleep 60; done\n  \n}\n\nfunction get_instance_id {\n    instance_id=\"$(curl -s --connect-timeout 20 http://169.254.169.254/openstack/2017-02-22/meta_data.json|grep -Po '\"uuid\": *\"\\K[^\"]*')\"\n    if [[ -n \"$instance_id\" ]]; then\n        echo $instance_id\n        return\n    fi\n\n    instance_id=\"$(cat /run/cloud-init/instance-data.json |grep -Po '\"uuid\": *\"\\K[^\"]*')\"\n    if [[ -n \"$instance_id\" ]]; then\n        echo $instance_id\n        return\n    fi\n\n    instance_id=\"$(cat /var/lib/cloud/data/instance-id)\"\n    echo $instance_id\n}\n\nfunction install_opensuse() {\n  \n  for i in {1..3}; do rpm -ivh --nodeps \"$1\" \u0026\u0026 break || sleep 60; done\n  \n}\n#\n\n\ntelegraf_deb_link=\"https://mcs-monitoring.hb.bizmrg.com/telegraf/telegraf_1.28.5-vkcs.2-1_amd64.deb\"\ntelegraf_rpm_link=\"https://mcs-monitoring.hb.bizmrg.com/telegraf/telegraf-1.28.5-vkcs.2-1.x86_64.rpm\"\n\n\nfunction install_telegraf {\n\tlocal name\n\tname=$(detect_os_name)\n\n\tcase \"$name\" in\n\t\tubuntu)\n\n\t\t\tinstall_ubuntu $telegraf_deb_link\n\t\t;;\n\t\tastra)\n\n\t\t\tinstall_astra $telegraf_deb_link\n\t\t;;\n\t\tdebian)\n\n\t\t\tinstall_debian $telegraf_deb_link\n\t\t;;\n\t\taltlinux)\n\n\t\t\tinstall_alt $telegraf_rpm_link\n\t\t;;\n\t\tcentos|almalinux)\n\n\t\t\tinstall_centos $telegraf_rpm_link\n\t\t;;\n\t\tredos)\n\n\t\t\tinstall_redos $telegraf_rpm_link\n\t\t;;\n\t\topensuse | opensuse-leap)\n\n\t\t    install_opensuse $telegraf_rpm_link\n\t\t;;\n\t\t*)\n\t\t\t_error \"usupported OS: $name\"\n\tesac\n}\n\ninstall_telegraf\n\n#\n\n\n\nmkdir -p /etc/telegraf/telegraf.d\n\ncat \u003c\u003c EOF \u003e /etc/telegraf/telegraf.conf\n[agent]\n  interval = \"10s\"\n  round_interval = false\n  metric_batch_size = 1000\n  metric_buffer_limit = 10000\n  collection_jitter = \"2s\"\n  flush_interval = \"10s\"\n  flush_jitter = \"2s\"\n  logfile = \"\"\n\n[[inputs.cpu]]\n  percpu = false\n  totalcpu = true\n  collect_cpu_time = false\n  report_active = false\n  fieldpass = [\"usage_user\", \"usage_system\", \"usage_iowait\", \"usage_irq\", \"usage_guest\"]\n\n[[inputs.mem]]\n  fieldpass = [\"available_percent\", \"available\", \"used_percent\", \"used\", \"free\", \"cached\", \"dirty\"]\n\n[[inputs.disk]]\n  ignore_fs = [\"tmpfs\", \"devtmpfs\", \"devfs\", \"iso9660\", \"overlay\", \"aufs\", \"squashfs\"]\n  fieldpass = [\"free\", \"used_percent\", \"inodes_free\"]\n\n[[inputs.diskio]]\n  fieldpass = [\"reads\", \"writes\", \"read_bytes\", \"write_bytes\", \"read_time\", \"write_time\", \"io_time\", \"weighted_io_time\"]\n\n[[inputs.net]]\n  fieldpass = [\"bytes_sent\", \"bytes_recv\", \"packets_sent\", \"packets_recv\", \"err_in\", \"err_out\", \"drop_in\", \"drop_out\"]\n\n[[inputs.netstat]]\n    fieldpass = [\"tcp_established\"]\n\nEOF\n\ncat \u003c\u003cEOF \u003e\u003e /etc/telegraf/telegraf.d/outputs.conf\n[[outputs.mcs_metrics]]\n\n  auth_url = \"https://infra.mail.ru:5000/v3/\"\n  user_id = \"41fed7914bc64c30818d37888c5ab28a\"\n  password = \"BU72bZDLJduGgxcjrRk3m2QsPyVuYQzsYAd6\"\n  project_id = \"8530029fa7b64199b2ad87c18d4620df\"\n\n  namespace = \"mcs/vm\"\n  endpoint = \"monitoring.mcs.mail.ru:443\"\nEOF\n\ninstance_id=\"$(get_instance_id)\"\n\nif [[ -n \"$instance_id\" ]]; then\n\ncat \u003c\u003cEOF \u003e /etc/telegraf/telegraf.d/uuid.conf\n[global_tags]\n  vm_uuid = \"$instance_id\"\nEO