{
  "name": "@twogc/cloudbridge-relay",
  "version": "1.0.0",
  "description": "Enterprise-grade high-performance relay server with WireGuard integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "docs": "typedoc src/index.ts --out docs",
    "example": "node dist/examples/basic.js"
  },
  "keywords": [
    "relay",
    "wireguard",
    "quic",
    "vpn",
    "p2p",
    "mesh",
    "enterprise",
    "security",
    "networking",
    "cloudflare",
    "post-quantum",
    "cryptography"
  ],
  "author": {
    "name": "2GC Team",
    "email": "dev@2gc.ru",
    "url": "https://2gc.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twogc/cloudbridge-relay-installer.git"
  },
  "bugs": {
    "url": "https://github.com/twogc/cloudbridge-relay-installer/issues"
  },
  "homepage": "https://github.com/twogc/cloudbridge-relay-installer#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0",
    "node-forge": "^1.3.1",
    "uuid": "^9.0.0",
    "prom-client": "^15.0.0",
    "winston": "^3.11.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "inquirer": "^9.2.12",
    "yaml": "^2.3.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@types/uuid": "^9.0.0",
    "@types/inquirer": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typedoc": "^0.25.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cloudbridge-relay": "./dist/cli.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
